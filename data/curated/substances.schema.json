{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://piru.app/schema/curated-substance.json",
  "title": "Piru curated substance",
  "description": "One hand-curated substance. One file per compound in data/curated/substances/<slug>.json, where <slug> == slugify(name). The authoritative enforced validator is pipeline/build/validate_curated.py (stdlib, build-consistent route normalisation); this schema is for editor support.",
  "type": "object",
  "required": [
    "name",
    "aliases",
    "category",
    "defaultRoute",
    "routes"
  ],
  "additionalProperties": true,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Canonical name (also the display title)."
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "category": {
      "type": "string",
      "enum": [
        "Stimulant",
        "Psychedelic",
        "Dissociative",
        "Dysdelic",
        "Deliriant",
        "Opioid",
        "Benzodiazepine",
        "GABAergic",
        "Empathogen",
        "Cannabinoid",
        "Nootropic",
        "AMPAkine",
        "Eugeroic",
        "Depressant",
        "OrexinAntagonist",
        "Antidepressant",
        "Antipsychotic",
        "Analgesic",
        "Antihistamine",
        "Cardiovascular",
        "Antimicrobial",
        "Gastrointestinal",
        "Respiratory",
        "Endocrine",
        "Immunological",
        "Supplement",
        "Peptide",
        "Anticonvulsant",
        "Other"
      ]
    },
    "defaultRoute": {
      "type": "string"
    },
    "routes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/route"
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "halfLifeMinutes": {
      "type": "number",
      "description": "Elimination half-life in MINUTES (12 h = 720). Curated, so it outranks every scraped source."
    },
    "halfLifeSource": {
      "type": "string",
      "description": "Citation for halfLifeMinutes specifically — a DOI, PMID, or URL. The `sources` array is substance-level provenance and does NOT cite this number."
    },
    "activeIngredient": {
      "type": "string",
      "description": "Canonical name of the molecule this preparation's pharmacology is actually measured on, when the preparation itself has none of its own (Cannabis → THC). Set it only when ONE molecule carries the psychoactivity and the library holds that molecule as its own substance; a preparation whose effect is an interaction between constituents has no single row that can stand for it."
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cas": {
      "type": "string"
    },
    "inchikey": {
      "type": "string"
    },
    "smiles": {
      "type": "string",
      "description": "Pins the STRUCTURE, not just the identity. Without it a curated file can assert an InChIKey and still have a source back-fill a contradicting SMILES (see Cathine, 2026-08-02). Ingested first, so it wins."
    },
    "formula": {
      "type": "string"
    },
    "pubchemCID": {
      "type": "integer"
    },
    "molarMass": {
      "type": "number"
    },
    "mechanismOfAction": {
      "$ref": "#/$defs/moa"
    },
    "peptideProfile": {
      "$ref": "#/$defs/peptideProfile"
    },
    "popularAliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Ordered common street/brand names for the detail header (≤~4). Popular substances only; distinct from the `aliases` search index. Never auto-derived."
    },
    "misconceptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mythBust"
      },
      "description": "Cited corrections to common claims (the 'Common misconceptions' section). Popular substances only."
    },
    "combinations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/combination"
      },
      "description": "Hand-curated notable combinations, editorial detail-page content. Ranked by evidence, not reputation. Popular substances only."
    },
    "waterHeat": {
      "type": "object",
      "required": [
        "headline",
        "body"
      ],
      "additionalProperties": false,
      "properties": {
        "headline": {
          "type": "string",
          "description": "Big-number display (e.g. '≈ 1 glass / hour')"
        },
        "body": {
          "type": "string",
          "description": "Explanation, may contain **bold**"
        }
      },
      "description": "Thermoregulation/hydration guidance card. Only for substances that raise body temperature or alter fluid balance."
    },
    "description": {
      "type": "string",
      "description": "Prose overview, shown on the substance detail page. Supplies the `descriptions` slot where no scraper filled it."
    },
    "subjectiveEffects": {
      "type": "array",
      "description": "Named effects with a sentence each. A bare string is accepted and stores the name alone.",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "range": {
      "type": "object",
      "required": [
        "lower",
        "upper"
      ],
      "properties": {
        "lower": {
          "type": "number"
        },
        "upper": {
          "type": "number"
        }
      }
    },
    "route": {
      "type": "object",
      "required": [
        "route",
        "unit"
      ],
      "properties": {
        "route": {
          "type": "string",
          "description": "RouteOfAdministration raw value (source aliases like nasal/iv are normalised at build)."
        },
        "unit": {
          "type": "string",
          "enum": [
            "mg",
            "mcg",
            "µg",
            "g",
            "IU",
            "mL"
          ]
        },
        "doses": {
          "type": "object",
          "properties": {
            "threshold": {
              "type": "number"
            },
            "heavy": {
              "type": "number"
            },
            "light": {
              "$ref": "#/$defs/range"
            },
            "common": {
              "$ref": "#/$defs/range"
            },
            "strong": {
              "$ref": "#/$defs/range"
            }
          }
        },
        "duration": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "min",
              "max"
            ],
            "properties": {
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              }
            }
          }
        },
        "protocolDosing": {
          "$ref": "#/$defs/protocolDosing"
        }
      }
    },
    "protocolDosing": {
      "type": "object",
      "required": [
        "frequency"
      ],
      "properties": {
        "lowAmount": {
          "type": "number"
        },
        "highAmount": {
          "type": "number"
        },
        "frequency": {
          "type": "string",
          "minLength": 1
        },
        "courseDuration": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "titration": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "amount",
              "label"
            ],
            "properties": {
              "amount": {
                "type": "number"
              },
              "label": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "peptideProfile": {
      "type": "object",
      "properties": {
        "sequence": {
          "type": [
            "string",
            "null"
          ]
        },
        "suppliedForm": {
          "type": "string",
          "enum": [
            "lyophilized_vial",
            "solution",
            "topical",
            "implant",
            "oral_capsule"
          ]
        },
        "typicalVialMg": {
          "type": [
            "number",
            "null"
          ]
        },
        "reconstitutionSolvent": {
          "type": [
            "string",
            "null"
          ]
        },
        "iuPerMg": {
          "type": [
            "number",
            "null"
          ]
        },
        "storage": {
          "type": "object",
          "properties": {
            "temperature": {
              "type": "string",
              "enum": [
                "room_temp",
                "refrigerate",
                "freeze"
              ]
            },
            "lightSensitive": {
              "type": "boolean"
            },
            "reconstitutedStabilityDays": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        }
      }
    },
    "mythBust": {
      "type": "object",
      "required": [
        "claim",
        "correction",
        "citations"
      ],
      "properties": {
        "claim": {
          "type": "string",
          "minLength": 1,
          "description": "The claim as people state it."
        },
        "correction": {
          "type": "string",
          "minLength": 1,
          "description": "Evidence-based correction; may contain **markdown bold**."
        },
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/mythCitation"
          },
          "description": "At least one — an uncited myth-bust is just a counter-assertion."
        },
        "pullQuote": {
          "type": "object",
          "required": [
            "text",
            "attribution"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "attribution": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": "Rare flagship-only attributed quotation."
        }
      }
    },
    "combination": {
      "type": "object",
      "required": [
        "severity",
        "name",
        "description"
      ],
      "properties": {
        "severity": {
          "enum": [
            "danger",
            "caution",
            "note"
          ]
        },
        "name": {
          "type": "string",
          "description": "Substance or class name (e.g. 'MAOIs', 'Alcohol')"
        },
        "description": {
          "type": "string",
          "description": "Plain-language explanation, may contain **bold**"
        },
        "note": {
          "type": "string",
          "description": "Optional qualifier tag (e.g. 'blunts')"
        }
      },
      "additionalProperties": false
    },
    "mythCitation": {
      "type": "object",
      "required": [
        "ref"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1,
          "description": "A reference string (doi:/pmid:/URL/free-text label), parsed by parse_reference()."
        },
        "role": {
          "type": "string",
          "enum": [
            "refutes",
            "retractedSource",
            "dataset"
          ],
          "default": "refutes",
          "description": "refutes = supporting evidence; retractedSource = the (retracted) origin of the myth, cited to discredit it; dataset = a registry/dataset."
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "description": "Optional one-line gloss shown beside the chip."
        }
      }
    },
    "moa": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "primaryTargets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "target",
              "action",
              "affinity"
            ],
            "properties": {
              "target": {
                "type": "string"
              },
              "action": {
                "type": "string",
                "enum": [
                  "agonist",
                  "partialAgonist",
                  "antagonist",
                  "inverseAgonist",
                  "positiveAllostericModulator",
                  "negativeAllostericModulator",
                  "reuptakeInhibitor",
                  "releasingAgent",
                  "enzymeInhibitor",
                  "channelBlocker",
                  "modulator"
                ]
              },
              "affinity": {
                "type": "integer",
                "enum": [
                  1,
                  2,
                  3
                ]
              }
            }
          }
        }
      }
    }
  }
}
