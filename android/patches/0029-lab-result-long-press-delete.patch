Injection Levels lab results on Android: a long press opens Delete. The rows sit in a ScrollView stack, where SkipUI gives .swipeActions no gesture, so the swipe's Delete was unreachable

diff --git a/Piru/Views/Tools/InjectionLevels/InjectionLevelsCards.swift b/Piru/Views/Tools/InjectionLevels/InjectionLevelsCards.swift
index 7451f4c3..e6e02223 100644
--- a/Piru/Views/Tools/InjectionLevels/InjectionLevelsCards.swift
+++ b/Piru/Views/Tools/InjectionLevels/InjectionLevelsCards.swift
@@ -82,9 +82,16 @@ struct LabCalibrationSection: View {
             .accessibilityLabel(lab.excludedFromCalibration ? Text("Excluded from calibration") : Text("Included in calibration"))
         }
         .padding(.vertical, Spacing.xs)
+        #if os(Android)
+            // These rows sit in a stack, where no swipe reaches them; a long press holds Delete, as Android rows offer their actions.
+            .contextMenu {
+                Button(role: .destructive) { onDelete(lab) } label: { Label("Delete", systemImage: "trash") }
+            }
+        #else
         .swipeActions {
             Button(role: .destructive) { onDelete(lab) } label: { Label("Delete", systemImage: "trash") }
         }
+        #endif
     }
 }
 
