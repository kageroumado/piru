--- a/Piru/Views/Launch/LaunchSheetModifier.swift
+++ b/Piru/Views/Launch/LaunchSheetModifier.swift
@@ -5,11 +5,17 @@ import SwiftUI
 enum LaunchSheet: Identifiable {
     case updateNotice(UpdateNotice)
     case discordInvite
+    #if os(Android)
+        case appUpdate(AppRelease)
+    #endif
 
     var id: String {
         switch self {
         case let .updateNotice(notice): "updateNotice.\(notice.rawValue)"
         case .discordInvite: "discordInvite"
+        #if os(Android)
+            case let .appUpdate(release): "appUpdate.\(release.tag)"
+        #endif
         }
     }
 }
@@ -55,6 +61,9 @@ struct LaunchSheetModifier: ViewModifier {
                 switch sheet {
                 case let .updateNotice(notice): UpdateNoticeView(notice: notice)
                 case .discordInvite: DiscordPromptView()
+                #if os(Android)
+                    case let .appUpdate(release): AppUpdateSheet(release: release)
+                #endif
                 }
             }
             .task {
@@ -67,6 +76,13 @@ struct LaunchSheetModifier: ViewModifier {
                 case .skinsPicker: navigator.present(.skins)
                 case nil: break
                 }
+                #if os(Android)
+                    // The release check can answer after the settle, and its sheet is still this launch's one.
+                    if sheet == nil, navigator.sheetStack.isEmpty {
+                        await AppUpdateCheck.shared.finishLaunchCheck()
+                        if sheet == nil, case let .sheet(next)? = nextCandidate() { sheet = next }
+                    }
+                #endif
             }
     }
 
@@ -85,6 +101,12 @@ struct LaunchSheetModifier: ViewModifier {
         if let notice = UpdateNotice.next(in: modelContext) {
             return .sheet(.updateNotice(notice))
         }
+        #if os(Android)
+            if let release = AppUpdateCheck.shared.releaseToAnnounce {
+                AppUpdateCheck.shared.markAnnounced(release)
+                return .sheet(.appUpdate(release))
+            }
+        #endif
         if skinsPickerIsDue {
             return .skinsPicker
         }
