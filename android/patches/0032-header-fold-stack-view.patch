+#if os(Android)
+    /// SkipFuseUI hosts no custom `Layout`: the two forms stack at the top, and the stack takes
+    /// the height between the two they last reported, `progress` of the way to the folded one.
+    struct HeaderFoldLayout<Content: View>: View {
+        let progress: CGFloat
+        let fullHeight: CGFloat
+        let foldedHeight: CGFloat
+        let content: Content
+
+        init(progress: CGFloat, fullHeight: CGFloat, foldedHeight: CGFloat, @ViewBuilder content: () -> Content) {
+            self.progress = progress
+            self.fullHeight = fullHeight
+            self.foldedHeight = foldedHeight
+            self.content = content()
+        }
+
+        var body: some View {
+            ZStack(alignment: .topLeading) { content }
+                .frame(height: progress == 0 ? nil : fullHeight + (foldedHeight - fullHeight) * progress, alignment: .top)
+        }
+    }
