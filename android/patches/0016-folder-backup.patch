Android backs up to a folder the user picks (Android/Backup/FolderBackup+Android.swift), since it has no iCloud: the section takes the iCloud section's place, and leaving the app runs it

diff --git a/Piru/App/AppLaunch.swift b/Piru/App/AppLaunch.swift
index 76e65a5e..1d908c05 100644
--- a/Piru/App/AppLaunch.swift
+++ b/Piru/App/AppLaunch.swift
@@ -268,6 +268,10 @@ enum AppLaunch {
     /// change-gated internally). A host that can be suspended keeps the process
     /// alive until this returns.
     static func enteredBackground(container: ModelContainer) async {
+        #if os(Android)
+            await FolderBackupManager.shared.run(context: container.mainContext)
+        #else
         await BackupManager.shared.runAutomaticBackup(context: container.mainContext)
+        #endif
     }
 }
