+// Copyright 2023–2026 Skip
+// SPDX-License-Identifier: MPL-2.0
+package skip.ui
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.DisposableEffect
+import androidx.compose.runtime.SideEffect
+import androidx.compose.runtime.compositionLocalOf
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.rememberUpdatedState
+
+/// Whether the tab holding this content is the one on screen. `TabView` keeps every visited tab
+/// composed and places only the selected one; the appearance modifiers and `task` read this so
+/// they follow what is visible, as SwiftUI's do.
+val LocalTabContentIsActive = compositionLocalOf { true }
+
+/// A disposable effect that runs only while its content's tab is on screen: `start` runs when the
+/// tab is shown and again whenever `key` changes while it is, and the function `start` returns runs
+/// when the tab is hidden, the key changes, or the content leaves the composition.
+@Composable
+fun ActiveEffect(key: Any?, start: () -> () -> Unit) {
+    val isActive = LocalTabContentIsActive.current
+    DisposableEffect(key, isActive) {
+        val stop = if (isActive) start() else null
+        onDispose { stop?.invoke() }
+    }
+}
+
+/// `onAppear`: `action` runs once per showing, and again when a hidden tab is shown. The tab's
+/// activity is read here, in this function's own scope, so a tab switch reruns this effect without
+/// re-rendering the content the modifier wraps.
+@Composable
+fun AppearEffect(action: (() -> Unit)?) {
+    val isActive = LocalTabContentIsActive.current
+    val hasAppeared = remember { mutableStateOf(false) }
+    if (isActive && !hasAppeared.value) {
+        hasAppeared.value = true
+        SideEffect { action?.invoke() }
+    } else if (!isActive && hasAppeared.value) {
+        hasAppeared.value = false
+    }
+}
+
+/// `onDisappear`: `action` runs when the content's tab is hidden or the content leaves, and not
+/// again when content already hidden with its tab leaves. Scoped like ``AppearEffect``.
+@Composable
+fun DisappearEffect(action: (() -> Unit)?) {
+    val isActive = LocalTabContentIsActive.current
+    val disposeAction = rememberUpdatedState(action)
+    DisposableEffect(isActive) {
+        onDispose {
+            if (isActive) {
+                disposeAction.value?.invoke()
+            }
+        }
+    }
+}
