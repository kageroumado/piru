 #if !SKIP_BRIDGE
 #if SKIP
+import androidx.compose.runtime.mutableStateOf
 import androidx.compose.runtime.remember
 import androidx.compose.runtime.SideEffect
 import androidx.compose.ui.focus.FocusRequester
+import androidx.compose.ui.platform.LocalFocusManager
 #endif
 
 extension View {
@@ -12,10 +14,13 @@
         #if SKIP
         return ModifiedContent(content: self, modifier: RenderModifier { renderable, context in
             let focusRequester = remember { FocusRequester() }
+            let focusManager = LocalFocusManager.current
+            let hasFocus = remember { mutableStateOf(false) }
             var context = context
             context.modifier = context.modifier
                 .focusRequester(focusRequester)
                 .onFocusChanged {
+                    hasFocus.value = $0.hasFocus
                     if $0.hasFocus {
                         binding.wrappedValue = value
                     } else if binding.wrappedValue == value {
@@ -32,6 +37,13 @@
                 // recomposition, so the next one, after layout, lands it.
                 // SKIP REPLACE: SideEffect { try { focusRequester.requestFocus() } catch (_: IllegalArgumentException) { } }
                 SideEffect { focusRequester.requestFocus() }
+            } else if hasFocus.value {
+                SideEffect {
+                    // Recheck ownership after other focus effects have run.
+                    if value != binding.wrappedValue && hasFocus.value {
+                        focusManager.clearFocus()
+                    }
+                }
             }
             renderable.Render(context: context)
         })
