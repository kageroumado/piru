# SwiftFormat configuration for Piru.

# Swift version (enables modern syntax-aware rules)
--swiftversion 6.3

# Wrapping style
--wraparguments before-first
--wrapparameters before-first
--wrapcollections before-first

# Attribute placement
--funcattributes prev-line
--typeattributes prev-line

# Enabled rules
--enable blankLineAfterImports,blockComments,wrapEnumCases,wrapSingleLineComments

# Disabled rules. redundantSelf is off: under Swift 6 strict concurrency it
# strips `self.` that the compiler REQUIRES in escaping/Sendable closures (e.g.
# GRDB's db.read { … }), breaking the build. Leave self management to the author.
#
# The whole wrap*Bodies family is off. SwiftFormat turned these on by default
# across 0.62/0.63, and each one expands a body this codebase writes on one line
# deliberately: `if x { return }`, `for p in tree { kill(p) }`,
# `var isActive: Bool { NSApp.isActive }`, `func id() -> String { rawValue }`.
# A single-line body is the house style wherever the body is one expression.
--disable wrapMultilineStatementBraces,wrapMultilineConditionalAssignment,blankLinesBetweenScopes,redundantInternal,redundantSelf,wrapIfStatementBodies,wrapIfExpressionBodies,wrapLoopBodies,wrapPropertyBodies,wrapFunctionBodies

# Header stripping
--header strip

# Numeric formatting — left as written. No threshold serves both `8081`, a port
# that must not be broken, and a byte count that reads better grouped; the author
# knows which a literal is.
--decimalgrouping ignore

# Import grouping
--importgrouping testable-last

# Preserve indentation on empty lines
--trimwhitespace nonblank

# Build artifacts, SPM checkouts, agent worktrees — never format these.
# (`build` + `**/DerivedData` cover the local `build/DerivedData/SourcePackages`
# SPM checkouts so local `swiftformat .` matches CI, which has no build dir.)
--exclude .build,**/.build,build,**/build,.claude,DerivedData,**/DerivedData,**/*.generated.swift
