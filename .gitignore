# Xcode
# Anchored: a bare `build/` also matches `pipeline/build/`, which is source.
# Its files were tracked from before the rule, so nothing broke visibly — new
# ones there were just silently invisible to `git status` and `git add`.
/build/
DerivedData/
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
xcuserdata/

# macOS
.DS_Store
*.swp
*~

# Swift Package Manager
Tools/SubstanceValidator/.build
Tools/SubstanceCollector/.build
Tools/SubstanceCollector/.cache

# SQLite journal sidecars (only the .sqlite itself is tracked)
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal

# Backup files
AppIcon_backup.png
*.bak
*.bak2

# Certificates (Apple's CAs are public, but no need to vendor them)
*.cer

# Claude Code session state
.claude/

# Specs are working documents, not source of truth
Specs/

# Skills CLI working files
.agents/
skills-lock.json

# Python build-script intermediates (repo-root translate_catalog.py, pipeline, etc.)
__pycache__/
*.pyc

# Regenerable verification dump (script: pipeline/audit/dump_for_verification.py).
# The audit findings under docs/audit/verification-findings/ are tracked; the
# raw per-substance dump itself is regenerable working output.
docs/audit/verification-dump/

# Regenerable merge outputs from pipeline/enrichment/merge.py — pure derivatives
# of data/enrichment/raw/*.json (which is tracked), not consumed by any
# downstream pipeline step. Re-run merge.py locally to inspect them.
data/enrichment/merged.json
data/enrichment/class-context.json
data/enrichment/coverage.csv

# Local archives / exports (not source)
Exports/

# Regenerable substance audit dump (script: PiruTests/SubstanceAuditExportTests.swift)
Audits/

# App Store marketing assets (screenshots + capture scaffolding), not app source
Store/
