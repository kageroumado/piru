# Xcode
# Anchored: a bare `build/` also matches `pipeline/build/`, which is source.
# Its files were tracked from before the rule, so nothing broke visibly — new
# ones there were just silently invisible to `git status` and `git add`.
/build/
DerivedData/
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
xcuserdata/

# macOS
.DS_Store
*.swp
*~

# Swift Package Manager
Tools/SubstanceValidator/.build
Tools/SubstanceCollector/.build
Tools/SubstanceCollector/.cache

# SQLite journal sidecars (only the .sqlite itself is tracked)
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal

# Backup files
AppIcon_backup.png
*.bak
*.bak2

# Certificates (Apple's CAs are public, but no need to vendor them)
*.cer

# Claude Code session state
.claude/

# Specs are working documents, not source of truth
Specs/

# Skills CLI working files
.agents/
skills-lock.json

# Python build-script intermediates (repo-root translate_catalog.py, pipeline, etc.)
__pycache__/
*.pyc

# The bundled substance DB is fetched by Tools/fetch-db.sh from the host that
# also serves it to installed builds. Do not track it, and do not reach for Git
# LFS: SubstanceDBUpdater downloads it over plain HTTP, and raw.githubusercontent
# serves an LFS path as its 133-byte pointer. manifest.json beside it STAYS
# tracked — it holds the checksum fetch-db.sh validates the download against.
Piru/Data/piru-substances.sqlite

# Bulk upstream API caches for the manual citation passes (audit/europepmc.py,
# the ChEMBL client in audit/citation_sourcing.py). Do not track these: at
# ~75-80 MB each they exceed GitHub's 50 MB advisory, JSON that size deltas so
# poorly that every citation pass appends another full blob, and the 100 MB hard
# limit is the wall that eventually rejects a push outright.
#
# Nothing offline needs them — the entire CI Python job and `build.sh fast` were
# run with both files absent and every gate passed. The offline gates read the
# small caches that stay tracked beside them: link-cache.json (the build),
# citation-verify-cache.json (verify_citations --offline) and
# citation-abstract-cache.json (citation_topicality --offline). Refilling these
# two is a network act on one machine, so the local copies are the useful ones.
data/sources/chembl-cache.json
data/sources/europepmc-cache.json

# Regenerable verification dump (script: pipeline/audit/dump_for_verification.py).
# Regenerable working output, not a record — rerun the script rather than keep it.
data/snapshots/verification-dump/

# Regenerable merge outputs from pipeline/enrichment/merge.py — pure derivatives
# of data/enrichment/raw/*.json (which is tracked), not consumed by any
# downstream pipeline step. Re-run merge.py locally to inspect them.
data/enrichment/merged.json
data/enrichment/class-context.json
data/enrichment/coverage.csv

# Local archives / exports (not source)
Exports/

# Regenerable substance audit dump (script: PiruTests/SubstanceAuditExportTests.swift)
Audits/

# App Store marketing assets (screenshots + capture scaffolding), not app source
Store/
