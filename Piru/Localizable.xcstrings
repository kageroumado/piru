          }
        }
      }
    },
    "Sleep when you can — your brain recovers fastest during rest." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "能睡就睡 — 大脑在休息时恢复最快。"
