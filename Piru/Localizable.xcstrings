    "Regular" : {
      "comment" : "Isomer picker: the standard/unspecified parent form",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "常规"
          }
        },
        "zh-Hant" : {
