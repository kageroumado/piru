    "Also measured at %@× %@'s %@ — a lab measurement, not clinical potency." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Also measured at %1$@× %2$@'s %3$@ — a lab measurement, not clinical potency."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También medido en %1$@× la %3$@ de %2$@ — una medición de laboratorio, no potencia clínica."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另有测定值为 %2$@ %3$@的 %1$@ 倍——这是实验室测定值，并非临床效价。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另有測定值為 %2$@ %3$@的 %1$@ 倍——這是實驗室測定值，並非臨床效價。"
          }
        }
      }
    },
    "Also measured at %@× %@'s %@ at the %@ — a lab measurement, not clinical potency." : {
