            "value" : "檔案不是有效的 JSON。"
          }
        }
      }
    },
    "The first label that applies is shown. When none does, the dock shows “—”." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示第一个适用的标签；都不适用时显示“—”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顯示第一個適用的標籤；都不適用時顯示「—」。"
          }
        }
      }
    },
    "The foggy feeling will clear. Give it hours." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "迷糊感会消散。需要数小时。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "迷糊感會消散。需要數小時。"
          }
        }
      }
    },
    "The four readouts" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "四项读数"
          }
        },
