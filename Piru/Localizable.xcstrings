            "value" : "依從性"
          }
        }
      }
    },
    "Adherence tracks how consistently you take your scheduled meds. Add one and this screen starts working." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依从性追踪你按计划服药的稳定程度。添加一项用药，这个页面就会开始工作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依從性追蹤你按計劃服藥的穩定程度。新增一項用藥，這個頁面就會開始運作。"
          }
        }
      }
    },
    "Adjust Time" : {
      "localizations" : {
        "zh-Hans" : {
