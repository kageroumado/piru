    "Repeated doses build up faster than the dose suggests" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las dosis repetidas se acumulan más rápido de lo que la dosis sugiere"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "反复用药会比单次剂量所暗示的更快蓄积"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "反覆用藥會比單次劑量所暗示的更快蓄積"
          }
        }
      }
    },
    "Repeated vomiting that only hot showers relieve is a recognized syndrome." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los vómitos repetidos que solo alivian las duchas calientes son un síndrome reconocido."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "反复呕吐、且只有热水澡能缓解，是一种已被认识的综合征。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "反覆嘔吐、且只有熱水澡能緩解，是一種已被認識的症候群。"
          }
        }
      }
    },
