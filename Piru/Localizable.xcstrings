    "Shown everywhere in place of \"%@\". Leave blank to keep the original name. Your dose history is unaffected." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在所有位置代替“%@”显示。留空则保留原名称。你的剂量记录不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
