    "Bioavailability versus dose: gabapentin falls as the dose rises, pregabalin stays flat." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biodisponibilidad frente a dosis: la gabapentina cae al subir la dosis, la pregabalina se mantiene estable."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生物利用度随剂量的变化：加巴喷丁随剂量升高而下降，普瑞巴林保持平稳。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生物利用度隨劑量的變化：加巴噴丁隨劑量升高而下降，普瑞巴林保持平穩。"
          }
        }
      }
    },
