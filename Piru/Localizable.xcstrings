          "stringUnit" : {
            "state" : "translated",
            "value" : "请至少使用 %lld 个字符。由多个单词组成的短语比短密码更安全，也更容易记住。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請至少使用 %lld 個字元。由多個單字組成的片語比短密碼更安全，也更容易記住。"
