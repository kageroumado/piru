          }
        }
      }
    },
    "Binding Kᵢ" : {
      "comment" : "Ternary basis option",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "结合 Kᵢ"
          }
        },
        "zh-Hant" : {
