    "Export, import, and encrypted backups to iCloud or a passphrase-protected file. Backups are optional and off by default." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导出、导入，以及加密备份到 iCloud 或口令保护的文件。备份为可选项，默认关闭。"
