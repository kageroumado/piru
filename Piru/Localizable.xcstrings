    "Plateaus around %@, %@× one dose, reached in %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "稳定在约 %@，为单次剂量的 %@ 倍，在 %@ 内达到"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "穩定在約 %@，為單次劑量的 %@ 倍，在 %@ 內達到"
          }
        }
      }
    },
    "Pleasure and warmth rise above the line; the comedown dips below." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "愉悦和暖意升到线以上；药效下降期沉到线以下。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
