      }
    },
    "Risk of respiratory depression, aspiration, and loss of consciousness." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有呼吸抑制、误吸和意识丧失的风险。"
