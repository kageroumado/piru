    "Serotonin accumulation risk — combining serotonergic agents increases toxicity chance." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riesgo de acumulación de serotonina — combinar agentes serotoninérgicos aumenta la probabilidad de toxicidad."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "血清素累积的风险——联合血清素能药物会增加毒性几率。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "血清素累積的風險——聯合血清素能藥物會增加毒性機率。"
          }
        }
      }
    },
    "Serotonin antagonist and reuptake inhibitor" : {
