          }
        }
      }
    },
    "Sleep quality may be off tonight — melatonin can help." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今晚睡眠质量可能欠佳 — 褪黑素有帮助。"
