    "Sign in to iCloud and turn on iCloud Drive to enable automatic encrypted backups." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录 iCloud 并开启 iCloud 云盘以启用自动加密备份。"
