    },
    "Slow central nervous system activity, mostly through GABA. Their doses add up with each other in a way that is easy to underestimate." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ralentizan la actividad del sistema nervioso central, sobre todo a través del GABA. Sus dosis se suman entre sí de una forma fácil de subestimar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "减缓中枢神经系统活动，主要通过 GABA。它们的剂量彼此叠加，其程度容易被低估。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "減緩中樞神經系統活動，主要透過 GABA。它們的劑量彼此疊加，其程度容易被低估。"
          }
        }
      }
    },
