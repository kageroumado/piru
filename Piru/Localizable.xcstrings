        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一切都會好的"
          }
        }
      }
    },
    "You're going to be okay. This feeling is temporary." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一切都会好的。这种感觉是暂时的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一切都會好的。這種感覺是暫時的。"
          }
        }
      }
    },
    "You're going to be okay. Whatever you're feeling right now is temporary." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一切都会好的。您现在的任何感受都是暂时的。"
