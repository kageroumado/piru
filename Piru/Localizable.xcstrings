    "Never abruptly stop after regular use — benzo withdrawal can be medically serious." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "规律使用后切勿突然停药 — 苯二氮䓬戒断可能在医学上非常严重。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "規律使用後切勿突然停藥 — 苯二氮䓬戒斷可能在醫學上非常嚴重。"
          }
        }
      }
    },
    "Never miss a dose" : {
