            "state" : "translated",
            "value" : "準備好後，隨時開啟端到端加密備份。"
          }
        }
      }
    },
    "Turn on location access in Settings to use your current location." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
