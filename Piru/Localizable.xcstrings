    "Light activity like walking helps burn off anxious energy." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una actividad ligera como caminar ayuda a quemar la energía ansiosa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "散步等轻度活动有助于消耗焦虑的能量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "散步等輕度活動有助於消耗焦慮的能量。"
          }
        }
      }
    },
    "Light food and fluids every few hours." : {
      "localizations" : {
