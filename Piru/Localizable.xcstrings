    },
    "Ki/EC50 values from primary literature with explicit source attribution. Lower Ki = tighter binding. Distinguish human vs. animal data when interpreting." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ki/EC50 数值来自原始文献，并标注明确来源。Ki 越低表示结合越紧密。解读时请区分人体与动物数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ki/EC50 數值來自原始文獻，並標註明確來源。Ki 越低表示結合越緊密。解讀時請區分人體與動物數據。"
          }
        }
      }
    },
