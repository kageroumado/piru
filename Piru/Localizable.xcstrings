    "No times yet. Add one below and the prompts start from your latest dose." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还没有设定时间。在下方添加一个，提示就会从你最近一次剂量开始计算。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
