    "Remember to hydrate, eat, and try to get some sleep. Your heart has been working hard." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recuerda hidratarte, comer e intentar dormir un poco. Tu corazón ha estado trabajando duro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记得补水、吃饭并尝试入睡。你的心脏一直在努力工作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記得補水、吃飯並嘗試入睡。你的心臟一直在努力工作。"
          }
        }
      }
    },
