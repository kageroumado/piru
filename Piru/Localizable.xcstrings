        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中樞抑制相加——鎮靜和損害加劇。"
          }
        }
      }
    },
    "Additive CNS depression — may increase sedation and respiratory depression risk." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中枢抑制相加——可能加剧镇静和呼吸抑制的风险。"
