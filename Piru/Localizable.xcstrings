    },
    "You're going to be okay. Whatever you're feeling right now is temporary." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一切都会好的。您现在的任何感受都是暂时的。"
