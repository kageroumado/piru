            "value" : "檔案缺少必要欄位：%@。"
          }
        }
      }
    },
    "The file isn't valid JSON." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文件不是有效的 JSON。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
