    "Molecule for molecule, %@ is about %@× as strong as %@ — but how much of a dose converts isn't recorded here." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Molecule for molecule, %1$@ is about %2$@× as strong as %3$@ — but how much of a dose converts isn't recorded here."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
