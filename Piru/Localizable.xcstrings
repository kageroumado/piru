    "Published benzodiazepine equivalence table" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabla publicada de equivalencias de benzodiacepinas"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
