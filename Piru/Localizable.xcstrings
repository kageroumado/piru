        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可能感到痛覺增強、焦躁或輕度噁心。"
          }
        }
      }
    },
    "You may feel shaky, anxious, or nauseous as your body recalibrates." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "身体重新校准时,您可能感到颤抖、焦虑或恶心。"
