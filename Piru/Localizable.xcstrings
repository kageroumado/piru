    "How you feel depends on what you took, how much, and your body's chemistry." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "感觉如何取决于您服用了什么、多少,以及您的身体化学。"
