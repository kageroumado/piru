            "value" : "濃度曲線"
          }
        }
      }
    },
    "Concentration Curves" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "浓度曲线"
          }
        },
        "zh-Hant" : {
