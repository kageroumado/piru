    "Severe respiratory depression — both are GABAergic depressants." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depresión respiratoria grave — ambos son depresores GABAérgicos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "严重呼吸抑制——两者都是 GABA 能中枢抑制药。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "嚴重呼吸抑制——兩者都是 GABA 能中樞抑制藥。"
          }
        }
      }
    },
    "Severe respiratory depression — both substances suppress breathing." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depresión respiratoria grave — ambas sustancias deprimen la respiración."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "严重呼吸抑制——两种物质都会抑制呼吸。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "嚴重呼吸抑制——兩種物質都會抑制呼吸。"
          }
        }
      }
    },
    "Severe respiratory depression — two direct-acting depressants with no shared ceiling." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depresión respiratoria grave — dos depresores de acción directa sin un techo compartido."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "严重呼吸抑制——两种直接起效的中枢抑制药，两者之间没有共同的上限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "嚴重呼吸抑制——兩種直接起效的中樞抑制藥，兩者之間沒有共同的上限。"
          }
        }
      }
    },
    "Severe respiratory depression and loss of consciousness." : {
