            "state" : "translated",
            "value" : "一切都會好的"
          }
        }
      }
    },
    "You're going to be okay. This feeling is temporary." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一切都会好的。这种感觉是暂时的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一切都會好的。這種感覺是暫時的。"
          }
        }
