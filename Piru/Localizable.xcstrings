    "Stacking benzodiazepines dramatically increases sedation and respiratory depression risk." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combinar benzodiacepinas aumenta drásticamente el riesgo de sedación y depresión respiratoria."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "叠加苯二氮䓬类会显著增加镇静和呼吸抑制的风险。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "疊加苯二氮平類會顯著增加鎮靜和呼吸抑制的風險。"
          }
        }
      }
    },
    "Stacking gabapentinoids compounds sedation and respiratory depression risk." : {
      "localizations" : {
