          }
        }
      }
    },
    "Synced from Apple Health. Your weight sizes every dose estimate — the same dose hits harder the less you weigh." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizado desde Apple Salud. Tu peso calibra cada estimación de dosis — la misma dosis pega más fuerte cuanto menos pesas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已从“健康”同步。体重决定每项剂量估算——越轻，同样的剂量作用越强。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已從「健康」同步。體重決定每項劑量估算——越輕，同樣的劑量作用越強。"
          }
        }
      }
    },
