      }
    },
    "Your brain burned through dopamine and norepinephrine faster than usual." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的大脑比平时更快地消耗了多巴胺和去甲肾上腺素。"
