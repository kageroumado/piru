    "Stop Live Activity" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detener Actividad en vivo"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止实时活动"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
