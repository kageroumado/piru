        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有呼吸抑制、誤吸和意識喪失的風險。"
          }
        }
      }
    },
    "Risk of seizures and serotonin toxicity — potentially fatal combination." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有癫痫发作和血清素毒性的风险 — 可能致命的组合。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有癲癇發作和血清素毒性的風險 — 可能致命的組合。"
          }
        }
      }
    },
    "Risk of seizures and serotonin toxicity — well-documented dangerous combination." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有癫痫发作和血清素毒性的风险 — 已有充分记录的危险组合。"
