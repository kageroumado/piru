    },
    "None of your logged substances in this range drive a modeled mechanism." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguna de las sustancias registradas en este rango activa un mecanismo modelado."
