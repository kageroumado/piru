        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可能感到情感開放、深思,或只是疲倦。"
          }
        }
      }
    },
    "You may feel foggy, lethargic, or mildly irritable." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可能感到迷糊、嗜睡或轻微易怒。"
