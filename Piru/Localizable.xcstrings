      }
    },
    "Antagonist" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拮抗剂"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拮抗劑"
          }
        }
      }
    },
    "Antagonizes both dopamine D2 and serotonin 5-HT2A receptors. The 5-HT2A antagonism modulates dopamine release in the nigrostriatal pathway, reducing extrapyramidal side effects compared to first-generation agents. May improve negative symptoms and cognitive function. Individual agents differ in their affinity for additional receptors including H1, α1, and muscarinic receptors." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同时拮抗多巴胺 D2 和血清素 5-HT2A 受体。5-HT2A 拮抗作用调节黑质纹状体通路中的多巴胺释放,与第一代药物相比,减少锥体外系副作用。可能改善阴性症状和认知功能。各药物在 H1、α1 和毒蕈碱等其他受体的亲和力上有差异。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同時拮抗多巴胺 D2 和血清素 5-HT2A 受體。5-HT2A 拮抗作用調節黑質紋狀體通路中的多巴胺釋放,與第一代藥物相比,減少錐體外系副作用。可能改善陰性症狀和認知功能。各藥物在 H1、α1 和蕈毒鹼等其他受體的親和力上有差異。"
          }
        }
      }
    },
    "Antibiotics, antivirals, and antifungals." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "抗生素、抗病毒与抗真菌药。"
