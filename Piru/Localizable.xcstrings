      }
    },
    "Skins pay for Piru's development. The journal, the library, and every tool are free." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los temas financian el desarrollo de Piru. El diario, la biblioteca y todas las herramientas son gratis."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "皮肤的收入用于支持 Piru 的开发。日记、物质库和所有工具均免费。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "皮膚的收入用於支持 Piru 的開發。日記、物質庫和所有工具均免費。"
          }
        }
      }
    },
