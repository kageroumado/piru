    "Low mood after a stimulant is commonly reported. If it turns into thoughts of harming yourself, use the numbers in Get Help." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es común reportar ánimo bajo tras un estimulante. Si se convierte en pensamientos de hacerte daño, usa los números de Pedir ayuda."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "兴奋剂之后常有人情绪低落。如果它变成了伤害自己的念头，请使用“获取帮助”里的号码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "興奮劑之後常有人情緒低落。如果它變成了傷害自己的念頭，請使用「取得協助」裡的號碼。"
          }
        }
      }
    },
    "Low mood, fatigue and emotional sensitivity in the days after are commonly reported." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es común reportar ánimo bajo, fatiga y sensibilidad emocional en los días posteriores."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "之后几天常有人情绪低落、疲劳、情绪敏感。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "之後幾天常有人情緒低落、疲勞、情緒敏感。"
          }
        }
      }
    },
