        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果下顎痠痛,輕柔按摩和鎂有幫助。"
          }
        }
      }
    },
    "Immune modulators and steroids." : {
      "localizations" : {
