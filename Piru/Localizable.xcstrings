    },
    "This permanently deletes all your data in the app and cannot be undone. Copies you exported, and device or iCloud backups, are not affected." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会永久删除你在应用中的全部数据，且无法撤销。你已导出的副本，以及设备或 iCloud 备份，不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會永久刪除你在 App 中的全部資料，且無法復原。你已匯出的副本，以及裝置或 iCloud 備份，不受影響。"
          }
        }
      }
    },
    "This replaces your current data with the %@ in this copy. A snapshot of your current data is taken first, so it's reversible. Restart Piru afterwards to load it." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将用此副本中的 %@ 替换你当前的数据。替换前会先为当前数据创建快照，因此可以撤销。之后请重新启动 Piru 以加载。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會用此副本中的 %@ 取代你目前的資料。取代前會先為目前資料建立快照，因此可以復原。之後請重新啟動 Piru 以載入。"
          }
        }
      }
    },
    "This session logs %@, which sit outside the model, so these curves stay empty." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本场包含 %@，它们不在模型范围内，因此这些曲线为空。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本場包含 %@，它們不在模型範圍內，因此這些曲線為空。"
          }
        }
      }
    },
    "This substance already has a \"%@\" unit." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该物质已有“%@”单位。"
