        }
      }
    },
    "Stimulants mask alcohol impairment — risk of overconsumption." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "兴奋剂会掩盖酒精损害 — 有过量饮用的风险。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "興奮劑會掩蓋酒精損害 — 有過量飲用的風險。"
          }
        }
      }
    },
    "Stimulants mask overdose signs — when they wear off, respiratory depression can emerge." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "兴奋剂会掩盖过量的征兆 — 一旦消退,呼吸抑制可能浮现。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "興奮劑會掩蓋過量的徵兆 — 一旦消退,呼吸抑制可能浮現。"
          }
        }
      }
    },
    "Stop Live Activity" : {
