    "Eliminates or inhibits the growth of microorganisms by targeting microbial-specific processes such as cell wall synthesis, protein synthesis, nucleic acid replication, metabolic pathways, or cell membrane integrity." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina o inhibe el crecimiento de microorganismos actuando sobre procesos específicos de los microbios, como la síntesis de la pared celular, la síntesis de proteínas, la replicación de ácidos nucleicos, las vías metabólicas o la integridad de la membrana celular."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过靶向微生物特异性过程（如细胞壁合成、蛋白质合成、核酸复制、代谢通路或细胞膜完整性）消除或抑制微生物生长。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過靶向微生物特異性過程（如細胞壁合成、蛋白質合成、核酸複製、代謝通路或細胞膜完整性）消除或抑制微生物生長。"
          }
        }
      }
    },
