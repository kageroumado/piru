    "Serotonin syndrome — potentially fatal. MAOIs block the enzyme that clears serotonin." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Síndrome serotoninérgico — potencialmente mortal. Los IMAO bloquean la enzima que elimina la serotonina."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "血清素综合征——可能致命。MAOI 会阻断清除血清素的酶。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "血清素症候群——可能致命。MAOI 會阻斷清除血清素的酵素。"
          }
        }
      }
    },
    "Serotonin syndrome — potentially fatal. The labels require a washout of weeks between them." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Síndrome serotoninérgico — potencialmente mortal. Los prospectos exigen un periodo de lavado de semanas entre ambos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "血清素综合征——可能致命。说明书要求两者之间有数周的洗脱期。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "血清素症候群——可能致命。說明書要求兩者之間有數週的沖洗期。"
          }
        }
      }
    },
    "Serotonin syndrome risk — a serotonin-raising drug stacked with a tricyclic antidepressant." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riesgo de síndrome serotoninérgico — un fármaco que eleva la serotonina combinado con un antidepresivo tricíclico."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "血清素综合征风险——升高血清素的药物与三环类抗抑郁药叠加。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "血清素症候群風險——升高血清素的藥物與三環類抗憂鬱藥疊加。"
          }
        }
      }
    },
    "Serotonin syndrome risk — a serotonin-raising drug stacked with an SNRI." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riesgo de síndrome serotoninérgico — un fármaco que eleva la serotonina combinado con un IRSN."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "血清素综合征风险——升高血清素的药物与 SNRI 叠加。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "血清素症候群風險——升高血清素的藥物與 SNRI 疊加。"
          }
        }
      }
    },
    "Serotonin syndrome risk — a serotonin-raising drug stacked with an SSRI." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riesgo de síndrome serotoninérgico — un fármaco que eleva la serotonina combinado con un ISRS."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
