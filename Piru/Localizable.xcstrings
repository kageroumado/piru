    "Familiar songs can ground you and bring comfort. Pick something you know well." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las canciones conocidas pueden anclarte y darte consuelo. Elige algo que conozcas bien."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "熟悉的歌曲能让你安定下来，也能带来慰藉。选一首你熟悉的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "熟悉的歌曲能讓你安定下來，也能帶來慰藉。選一首你熟悉的。"
          }
        }
      }
    },
    "Fast and real, but recovers fairly quickly once you stop." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rápida y real, pero se recupera bastante pronto una vez que paras."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "又快又真实，但停用后恢复得相当快。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "又快又真實，但停用後恢復得相當快。"
          }
        }
      }
    },
    "Fast metabolizer" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metabolizador rápido"
