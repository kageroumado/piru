    "Deletes journal records, profile, schedules, inventory, custom presets and local recovery copies. Watch deletion takes effect when it reconnects." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina los registros del diario, el perfil, las programaciones, el inventario, los preajustes personalizados y las copias de recuperación locales. La eliminación en el Watch se aplica cuando se vuelve a conectar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除日志记录、个人资料、计划、库存、自定义预设和本地恢复副本。Watch 上的删除会在重新连接后生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除日誌記錄、個人資料、排程、庫存、自訂預設和本機復原副本。Watch 上的刪除會在重新連線後生效。"
          }
        }
      }
    },
