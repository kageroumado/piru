    "Higher is better" : {

    },
    "Higher is better. Pleasure and warmth rise above the line; the comedown dips below." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "越高越好。愉悦与暖意升至基线之上；退效期则跌至其下。"
