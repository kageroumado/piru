    "Risk of fatal serotonin syndrome — do not combine." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有致命血清素综合征的风险 — 切勿合用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有致命血清素綜合徵的風險 — 切勿合用。"
          }
        }
      }
    },
    "Risk of respiratory depression, aspiration, and loss of consciousness." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有呼吸抑制、误吸和意识丧失的风险。"
