    "Faint" : {

    },
    "Faint dots are other compounds measured on the same basis — each in its own study, drawn for scale." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "浅色圆点是以相同基准测得的其他化合物——各自出自不同研究，仅用于呈现量级。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "淺色圓點是以相同基準測得的其他化合物——各自出自不同研究，僅用於呈現量級。"
          }
        }
      }
    },
    "falling" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下降"
          }
        },
