    },
    "Kick-in and wear-off come from this med's own duration data — the same model the timeline draws. An estimate." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El inicio y el fin del efecto salen de los datos de duración de este medicamento — el mismo modelo que dibuja la línea de tiempo. Es una estimación."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "起效与消退时间来自这款药物自身的持续时间数据——与时间线所用的模型相同。这是估算。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "起效與消退時間來自這款藥物自身的持續時間資料——與時間線所用的模型相同。這是估算。"
          }
        }
      }
    },
