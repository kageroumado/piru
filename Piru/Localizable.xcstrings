            "value" : "開"
          }
        }
      }
    },
    "On a fixed schedule doses overlap and the level climbs until intake and clearance balance: steady state." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con una pauta fija las dosis se superponen y el nivel sube hasta que la entrada y la eliminación se equilibran: el estado estacionario."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "固定方案下各剂量相互重叠，水平持续上升，直到摄入与清除平衡：稳态。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "固定方案下各劑量相互重疊，水平持續上升，直到攝入與清除平衡：穩態。"
          }
        }
      }
    },
