    },
    "Armodafinil induces CYP3A4, lowering the levels of drugs cleared by it — including the hormones in systemic contraception." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "阿莫达非尼可诱导 CYP3A4，降低经其清除的药物的血药浓度——包括全身性激素避孕药中的激素。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "阿莫達非尼可誘導 CYP3A4，降低經其清除的藥物的血藥濃度——包括全身性激素避孕藥中的激素。"
          }
        }
      }
    },
    "Arrange Classes" : {
