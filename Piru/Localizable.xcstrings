    "Using the average 60 kg. Set yours above so estimates fit your body — the same dose hits harder the less you weigh." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usando el promedio de 60 kg. Indica el tuyo arriba para que las estimaciones se ajusten a tu cuerpo — la misma dosis pega más fuerte cuanto menos pesas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正使用平均值 60 kg。在上方设置你的体重，让估算贴合你自己——越轻，同样的剂量作用越强。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正使用平均值 60 kg。在上方設定你的體重，讓估算貼合你自己——越輕，同樣的劑量作用越強。"
          }
        }
      }
    },
