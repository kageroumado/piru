        }
      }
    },
    "This file isn't a valid Piru backup." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文件不是有效的 Piru 备份。"
          }
        },
        "zh-Hant" : {
