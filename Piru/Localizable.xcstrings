    "Bind the α2δ subunit of voltage-gated calcium channels, reducing excitatory transmitter release. Not GABAergic despite the name." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se unen a la subunidad α2δ de los canales de calcio dependientes de voltaje, reduciendo la liberación de transmisores excitatorios. No son GABAérgicos a pesar del nombre."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "结合电压门控钙通道的 α2δ 亚基，减少兴奋性递质释放。名称虽如此，但并非 GABA 能药物。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "結合電壓閘控鈣通道的 α2δ 次單元，減少興奮性遞質釋放。名稱雖如此，但並非 GABA 能藥物。"
          }
        }
      }
    },
