    "Details are in Settings under About Piru." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "详情见“设置”中的“关于 Piru”。"
          }
        },
        "zh-Hant" : {
