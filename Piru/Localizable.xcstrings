    "Starts at %@, fading toward none." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza en %@ y se desvanece hasta desaparecer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从 %@ 开始，逐渐消退至无。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從 %@ 開始，逐漸消退至無。"
          }
        }
      }
    },
    "Starts at today's level from your log. Next dose one interval after your last." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza en el nivel de hoy según tu diario. La siguiente dosis, un intervalo después de la última."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从记录中今天的水平开始。下一剂在上一剂后一个间隔。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從記錄中今天的水平開始。下一劑在上一劑後一個間隔。"
          }
        }
      }
    },
