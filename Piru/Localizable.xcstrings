        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本月依從性日曆"
          }
        }
      }
    },
    "This opioid has no linear MME factor — see the note below." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这种阿片类没有线性的 MME 系数——见下方说明。"
