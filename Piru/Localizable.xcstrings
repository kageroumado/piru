    "None of your logged substances in this range drive a modeled mechanism." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此范围内记录的物质都不驱动任何可建模的机制。"
          }
        },
        "zh-Hant" : {
