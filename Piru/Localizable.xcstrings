    "Active in micrograms — a thousandth of a milligram. Always measure volumetrically. You cannot dose this by eye." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activo en microgramos — una milésima de miligramo. Mide siempre volumétricamente. No puedes dosificarlo a ojo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "微克量级即有效——一毫克的千分之一。必须容积法测量。无法靠目测给药。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "微克量級即有效——一毫克的千分之一。必須容積法測量。無法靠目測給藥。"
          }
        }
      }
    },
