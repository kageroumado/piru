            "value" : "自動備份"
          }
        }
      }
    },
    "Automatic backups use a random key kept in your iCloud Keychain. It never leaves your devices in readable form, so iCloud only ever holds an unreadable blob." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动备份使用保存在你 iCloud 钥匙串中的随机密钥。它绝不会以可读形式离开你的设备，因此 iCloud 上只会保存一段无法读取的数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動備份使用儲存在你 iCloud 鑰匙圈中的隨機金鑰。它絕不會以可讀形式離開你的裝置，因此 iCloud 上只會保存一段無法讀取的資料。"
          }
        }
      }
    },
    "Automatic Live Activity" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动实时活动"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動即時動態"
          }
        }
      }
    },
    "Automatically show a Live Activity on the Lock Screen and Dynamic Island when you start tracking a substance. You can also start one manually from a day or entry's detail view." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开始追踪某种物质时，自动在锁定屏幕和灵动岛上显示实时活动。你也可以在某一天或某条记录的详情页中手动开启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開始追蹤某種物質時，自動在鎖定畫面和動態島上顯示即時動態。你也可以在某一天或某筆記錄的詳情頁中手動開啟。"
          }
        }
      }
    },
    "Availability" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "获取方式"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取得方式"
          }
        }
      }
    },
    "Avg" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平均"
          }
        },
        "zh-Hant" : {
