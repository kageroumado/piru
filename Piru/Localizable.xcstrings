    "Keep Logging" : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "继续记录"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
