            "value" : "體內負荷（藥動）"
          }
        }
      }
    },
    "Boiling point" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punto de ebullición"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沸点"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沸點"
          }
        }
      }
    },
    "Both active %@–%@ (%@ overlap)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Both active %1$@–%2$@ (%3$@ overlap)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambas activas %@–%@ (%@ de superposición)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两者在 %@–%@ 同时活跃（重叠 %@）"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "兩者在 %@–%@ 同時活躍（重疊 %@）"
          }
        }
      }
    },
    "Both can lower blood pressure and add to dizziness — you may feel faint, especially standing up." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambos pueden bajar la presión arterial y sumar mareo — puedes sentirte a punto de desmayarte, sobre todo al ponerte de pie."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两者都会降低血压并增加头晕——可能感到眩晕，尤其是起身时。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "兩者都會降低血壓並增加頭暈——可能感到眩暈，尤其是起身時。"
          }
        }
      }
    },
    "Both cause drowsiness — additive next-day sedation and grogginess." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambos causan somnolencia — sedación y aturdimiento aditivos al día siguiente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两者都会引起困倦——次日的镇静和昏沉会叠加。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "兩者都會引起睏倦——次日的鎮靜和昏沉會疊加。"
          }
        }
      }
    },
    "Both groups have similar ratings." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambos grupos tienen valoraciones similares."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两组评分相近。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "兩組評分相近。"
          }
        }
      }
    },
    "Both raise serotonin, so serotonin syndrome is possible — agitation, tremor, sweating, a racing heart — and most likely in the first weeks. This pairing is prescribed and monitored on purpose; SNRIs do not raise lithium levels." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambos elevan la serotonina, así que es posible un síndrome serotoninérgico — agitación, temblor, sudoración, taquicardia — sobre todo en las primeras semanas. Esta combinación se prescribe y se supervisa a propósito; los IRSN no elevan los niveles de litio."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两者都会升高血清素，因此可能出现血清素综合征——躁动、震颤、出汗、心跳加快，最常见于开始用药的头几周。这个组合本就是医生有意开出并加以监测的；SNRI 不会升高锂的血药浓度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "兩者都會升高血清素，因此可能出現血清素症候群——躁動、顫抖、出汗、心跳加快，最常見於開始用藥的頭幾週。這個組合本就是醫師有意開出並加以監測的；SNRI 不會升高鋰的血藥濃度。"
          }
        }
      }
    },
    "Both raise serotonin, so serotonin syndrome is possible — agitation, tremor, sweating, a racing heart — and most likely in the first weeks. This pairing is prescribed and monitored on purpose; SSRIs do not raise lithium levels." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambos elevan la serotonina, así que es posible un síndrome serotoninérgico — agitación, temblor, sudoración, taquicardia — sobre todo en las primeras semanas. Esta combinación se prescribe y se supervisa a propósito; los ISRS no elevan los niveles de litio."
          }
