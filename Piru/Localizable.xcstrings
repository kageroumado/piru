        }
      }
    },
    "Enhanced CNS depression — risk of respiratory depression and death." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加重的中枢抑制 — 有呼吸抑制和死亡的风险。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加重的中樞抑制 — 有呼吸抑制和死亡的風險。"
          }
        }
      }
    },
    "Enhanced respiratory depression — gabapentinoids increase opioid overdose risk." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加重的呼吸抑制 — 加巴喷丁类增加阿片过量风险。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加重的呼吸抑制 — 加巴噴丁類增加阿片過量風險。"
          }
        }
      }
    },
    "Enough time has passed since your last dose. This is a model estimate — follow your prescriber's schedule." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "距离你的上一剂已经过了足够的时间。这是模型估算——请遵循处方医生的安排。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "距離你的上一劑已經過了足夠的時間。這是模型估算——請遵循處方醫生的安排。"
          }
        }
      }
    },
    "Enter a dose to convert." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
