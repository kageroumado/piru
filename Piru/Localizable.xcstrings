    "Sources at the top take precedence when a fact is reported by multiple sources. Disabled sources are hidden from resolved values but still searchable in advanced views." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当多个来源报告同一事实时，位于顶部的来源优先。已禁用的来源不会出现在解析后的数值中，但在高级视图中仍可搜索。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當多個來源報告同一事實時，位於頂部的來源優先。已停用的來源不會出現在解析後的數值中，但在進階檢視中仍可搜尋。"
          }
