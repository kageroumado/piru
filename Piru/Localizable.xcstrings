    "Shown everywhere in place of \"%@\". Leave blank to keep the original name. Your dose history is unaffected." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se muestra en todas partes en lugar de «%@». Déjalo en blanco para conservar el nombre original. Tu historial de dosis no cambia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
