    "Risk of fatal serotonin syndrome — MAOIs block the enzyme that clears the serotonin an empathogen releases." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riesgo de síndrome serotoninérgico mortal — los IMAO bloquean la enzima que elimina la serotonina que libera un empatógeno."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有致命的血清素综合征风险——MAOI 会阻断清除共情剂所释放血清素的酶。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有致命的血清素症候群風險——MAOI 會阻斷清除共情劑所釋放血清素的酵素。"
          }
        }
      }
    },
    "Risk of respiratory depression, aspiration, and loss of consciousness." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riesgo de depresión respiratoria, aspiración y pérdida de consciencia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有呼吸抑制、误吸和意识丧失的风险。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有呼吸抑制、誤吸和意識喪失的風險。"
          }
        }
      }
    },
    "Risk of serotonin syndrome and hypertensive crisis." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riesgo de síndrome serotoninérgico y crisis hipertensiva."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有血清素综合征和高血压危象的风险。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有血清素症候群和高血壓危象的風險。"
          }
        }
      }
    },
    "Risk of serotonin syndrome, especially with meperidine/pethidine, tramadol, and tapentadol." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riesgo de síndrome serotoninérgico, especialmente con meperidina/petidina, tramadol y tapentadol."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有血清素综合征的风险，尤其是与哌替啶、曲马多和他喷他多。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有血清素症候群的風險，尤其是與哌替啶、曲馬多和他噴他多。"
          }
        }
      }
    },
