          }
        }
      }
    },
    "Sleep if you can. Your body does its best recovery work unconscious." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "能睡就睡。身体在无意识时做最好的恢复工作。"
