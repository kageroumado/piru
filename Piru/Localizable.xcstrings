    },
    "Serotonin accumulation risk — combining serotonergic agents increases toxicity chance." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "血清素累积的风险——联合血清素能药物会增加毒性几率。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
