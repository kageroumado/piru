    },
    "Additive sedation — may increase drowsiness and impaired coordination." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "镇静相加 — 可能加剧嗜睡和协调受损。"
