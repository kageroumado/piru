    "Entries before this hour count toward the previous day. Set to 12 AM for standard calendar days." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los registros anteriores a esta hora cuentan para el día anterior. Ajústalo a medianoche para días de calendario estándar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此时间之前的记录计入前一天。设为 12 AM 即按标准日历日。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此時間之前的記錄計入前一天。設為 12 AM 即按標準日曆日。"
          }
        }
      }
    },
    "Entries by hour of day" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registros por hora del día"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按时段统计的条目"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按時段統計的條目"
          }
        }
      }
    },
    "Entries from the backup will be added to your current data. Duplicates are skipped. Automatic backups will be turned on." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los registros de la copia de seguridad se añadirán a tus datos actuales. Los duplicados se omiten. Se activarán las copias de seguridad automáticas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备份中的记录将添加到当前数据。重复项会跳过。自动备份将开启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "備份中的記錄將加入目前資料。重複項會跳過。自動備份將開啟。"
          }
        }
      }
    },
    "Entries per day" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registros por día"
          }
        },
        "zh-Hans" : {
