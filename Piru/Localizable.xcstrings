    "About two-thirds discontinue short-term; roughly one-third sustain long-term. Consensus rate: 25% reduction per week over 4–6 weeks." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "约三分之二短期成功停药；约三分之一长期维持。共识方案：4–6周内每周减少25%。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
