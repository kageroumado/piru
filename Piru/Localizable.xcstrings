          }
        }
      }
    },
    "A binding-affinity measurement, not clinical potency." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una medición de afinidad de unión, no potencia clínica."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是受体结合亲和力的测定值，并非临床效价。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這是受體結合親和力的測定值，並非臨床效價。"
