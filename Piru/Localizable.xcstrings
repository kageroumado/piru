    "Splits a busy session's overlapping curves into one lane per substance." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将繁忙场次中重叠的曲线按物质拆分为各自的泳道。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將繁忙場次中重疊的曲線按物質拆分為各自的泳道。"
          }
        }
      }
    },
    "Sporadic" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "零星"
          }
        },
