          "stringUnit" : {
            "state" : "translated",
            "value" : "這一半更有用。"
          }
        }
      }
    },
    "This is a rebound effect. It passes." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是反弹效应。它会过去。"
