    "Common-dose units by weekday, most on %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按星期统计的中等剂量单位，%@ 最多"
          }
        },
        "zh-Hant" : {
