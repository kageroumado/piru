    "Coordination" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "协调"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "協調"
          }
        }
      }
    },
    "Coordination goes before you notice it has. Stairs and the kitchen are where that lands." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "协调性会在你察觉之前先走。楼梯和厨房是最容易出事的地方。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "協調性會在你察覺之前先走。樓梯和廚房是最容易出事的地方。"
          }
        }
      }
    },
    "Copied" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已复制"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已複製"
          }
        }
      }
    },
    "Copies a plain-text summary of substances and recent doses to share with emergency responders." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将物质和最近剂量的纯文本摘要复制到剪贴板，以便与急救人员分享。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將物質和最近劑量的純文字摘要複製到剪貼簿，以便與急救人員分享。"
          }
        }
      }
    },
    "Copies only when you ask" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只在你要求时才生成副本"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只在你要求時才生成副本"
          }
        }
      }
    },
    "Copies set aside automatically (after an upgrade hiccup) or before a restore appear here, ready to restore." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动保存的副本（升级出错后）或恢复前的副本会显示在这里，可随时恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動儲存的副本（升級出錯後）或還原前的副本會顯示在這裡，可隨時還原。"
          }
        }
      }
    },
    "Copy" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "复制"
          }
