    "Regular" : {
      "comment" : "Isomer picker: the standard/unspecified parent form",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normal"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
