    "NMDA Receptor Antagonist (Dissociative)" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NMDA 受体拮抗剂(解离剂)"
          }
        },
        "zh-Hant" : {
