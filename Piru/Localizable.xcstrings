    "Slide to move, pinch to zoom, and hold to inspect a moment." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza para moverte, pellizca para ampliar y mantén presionado para inspeccionar un momento."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "滑动移动，捏合缩放，长按查看某一时刻。"
