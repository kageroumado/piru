        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 %@ 已用盡。請盡快補充。"
          }
        }
      }
    },
    "You're safe. If the experience was intense, remind yourself: it's temporary." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您是安全的。如果体验很强烈,请提醒自己:这是暂时的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您是安全的。如果體驗很強烈,請提醒自己:這是暫時的。"
          }
        }
      }
    },
    "You've already created this shade" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已创建过此颜色"
