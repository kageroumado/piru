    "Memory and coordination can stay impaired after the sedation lifts." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La memoria y la coordinación pueden seguir afectadas después de que pase la sedación."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "镇静感消退后，记忆和协调性仍可能受损。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鎮靜感消退後，記憶和協調性仍可能受損。"
          }
        }
      }
    },
    "Mental Helse" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mental Helse"
          }
