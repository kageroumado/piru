    "Appetite changes and sleep disruption are common after heavy sessions." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大量使用后,食欲变化和睡眠紊乱很常见。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大量使用後,食慾變化和睡眠紊亂很常見。"
          }
        }
      }
    },
    "Are you sure you want to delete all your data? This action cannot be undone." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "确定要删除所有数据吗？此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確定要刪除所有資料嗎？此操作無法復原。"
          }
        }
      }
    },
    "At this timing, the substances are not simultaneously active above threshold." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在此时间点,这些物质未同时高于阈值活跃。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在此時間點,這些物質未同時高於閾值活躍。"
          }
        }
      }
    },
