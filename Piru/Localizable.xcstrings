    "Distress or perceptual changes that persist for days are worth taking to a professional." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si el malestar o los cambios perceptivos persisten durante días, vale la pena consultarlo con un profesional."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "持续数天的痛苦或知觉变化，值得去找专业人士看看。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "持續數天的痛苦或知覺變化，值得去找專業人士看看。"
          }
        }
      }
    },
    "Distribution" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distribución"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分布容积"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分布容積"
          }
        }
      }
    },
    "Do not drive or operate machinery. Feeling normal does not establish that you can drive safely." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No conduzcas ni manejes maquinaria. Sentirte normal no demuestra que puedas conducir con seguridad."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不要开车或操作机械。感觉正常并不能证明你可以安全驾驶。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不要開車或操作機械。感覺正常並不能證明你可以安全駕駛。"
          }
        }
      }
    },
    "Do not drive. Feeling less sedated does not establish that memory or coordination are unimpaired." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No conduzcas. Sentir menos sedación no demuestra que la memoria o la coordinación estén intactas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不要开车。感觉没那么困，并不能证明记忆或协调性没有受损。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不要開車。感覺沒那麼睏，並不能證明記憶或協調性沒有受損。"
          }
        }
      }
    },
    "Do not drive. Feeling normal does not establish that you can drive safely." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No conduzcas. Sentirte normal no demuestra que puedas conducir con seguridad."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不要开车。感觉正常并不能证明你可以安全驾驶。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不要開車。感覺正常並不能證明你可以安全駕駛。"
          }
        }
      }
    },
    "Do not drive. Impairment outlasts the feeling of being high." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No conduzcas. El deterioro dura más que la sensación de estar bajo los efectos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不要开车。功能受损持续的时间比“嗨”的感觉更长。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不要開車。功能受損持續的時間比「嗨」的感覺更長。"
          }
        }
      }
    },
