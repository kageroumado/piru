    "Log a few doses and each substance's tolerance shows up here." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra unas cuantas dosis y la tolerancia de cada sustancia aparecerá aquí."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记录几次剂量后，每种物质的耐受性都会显示在这里。"
          }
        },
