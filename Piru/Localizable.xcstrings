          "stringUnit" : {
            "state" : "translated",
            "value" : "中樞和呼吸抑制相加。"
          }
        }
      }
    },
    "Additive CNS depression — increased sedation and impaired coordination." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中枢抑制相加——镇静加剧、协调受损。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中樞抑制相加——鎮靜加劇、協調受損。"
          }
        }
      }
    },
    "Additive CNS depression — increased sedation and impairment." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中枢抑制相加——镇静和损害加剧。"
