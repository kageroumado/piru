    "Barcodes are matched offline against the US and French registries the app ships with. Anything else resolves by name." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "条码离线匹配 App 内置的美国和法国药品登记数据；其他情况按名称解析。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
