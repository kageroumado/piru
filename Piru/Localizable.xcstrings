            "state" : "translated",
            "value" : "這些是什麼意思？"
          }
        }
      }
    },
    "What do you notice?" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你注意到了什么？"
          }
        },
