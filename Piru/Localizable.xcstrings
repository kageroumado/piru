            "value" : "Mostrar siempre la línea de tiempo a altura completa. Si está desactivado, los gráficos empiezan compactos — expándelos desde el menú del gráfico."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
