        }
      }
    },
    "Be easy with yourself — profound experiences need time to settle." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "善待自己 — 深刻的体验需要时间沉淀。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "善待自己 — 深刻的體驗需要時間沉澱。"
          }
        }
      }
    },
    "Be patient with yourself for the next 1-3 days. Low mood is the serotonin dip." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接下来 1 至 3 天对自己耐心点。情绪低落是血清素下降。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接下來 1 至 3 天對自己耐心點。情緒低落是血清素下降。"
          }
        }
      }
    },
    "Be very careful. Don't mix with other downers. Have naloxone nearby if possible." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "务必小心。不要与其他抑制剂混用。如果可能,请准备纳洛酮。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "務必小心。不要與其他抑制劑混用。如果可能,請準備納洛酮。"
          }
        }
      }
    },
