          "stringUnit" : {
            "state" : "translated",
            "value" : "皮肤的收入用于支持 Piru 的开发。无论买不买，日记、物质库和所有工具都是免费的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
