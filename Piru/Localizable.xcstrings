    "Stay seated or lying down. Your balance may not be what you think it is." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保持坐姿或躺下。你的平衡感可能不如你以为的好。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保持坐姿或躺下。你的平衡感可能不如你以為的好。"
          }
        }
      }
    },
    "Stay somewhere calm and safe." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "待在平静、安全的地方。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "待在平靜、安全的地方。"
          }
        }
      }
    },
    "Stay somewhere safe with someone you trust if possible." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果可能，留在安全的地方，有你信任的人在身边。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果可能，留在安全的地方，有你信任的人在身邊。"
          }
        }
      }
    },
    "Stay somewhere safe. Don't drive. Your coordination and judgment are affected." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "留在安全的地方。不要开车。你的协调能力和判断力受到影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "留在安全的地方。不要開車。你的協調能力和判斷力受到影響。"
          }
        }
      }
    },
    "Stay with someone, or let someone know to check on you. Heavy snoring or gurgling in sleep is a warning sign, not rest." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "和别人待在一起，或者让人知道要来看看你。睡眠中鼾声很重或有咕噜声是警示信号，不是在休息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "和別人待在一起，或者讓人知道要來看看你。睡眠中鼾聲很重或有咕嚕聲是警示訊號，不是在休息。"
          }
        }
      }
    },
