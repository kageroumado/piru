    "Used to show how many doses you have left. Set to 0 to disable." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于显示你还剩多少次剂量。设为 0 可停用。"
