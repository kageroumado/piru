        }
      }
    },
    "Based on first-pass metabolism of oral THC · educational. Onset and duration vary with dose, product, and tolerance." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basado en el metabolismo de primer paso del THC oral · educativo. El inicio y la duración varían con la dosis, el producto y la tolerancia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基于口服 THC 的首过代谢 · 仅供教育参考。起效与持续时间因剂量、产品和耐受性而异。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基於口服 THC 的首過代謝 · 僅供教育參考。起效與持續時間因劑量、產品和耐受性而異。"
          }
        }
      }
    },
    "Based on your self-reported alcohol flush · educational." : {
