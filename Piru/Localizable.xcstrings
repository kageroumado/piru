    "Nudges and re-asks stay silent during quiet hours. Scheduled reminders and safety warnings still come through." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los avisos y las repreguntas se silencian durante las horas de silencio. Los recordatorios programados y las advertencias de seguridad sí llegan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "静音时段内不会推送提示和再次询问。定时提醒和安全警告仍会送达。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "靜音時段內不會推送提示和再次詢問。定時提醒和安全警告仍會送達。"
          }
        }
      }
    },
