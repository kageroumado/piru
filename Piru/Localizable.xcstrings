    },
    "Combined load across your active GABAergics, relative to your recent peak." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你所有仍在起效的 GABA 类物质的合并负荷，相对于近期峰值。"
