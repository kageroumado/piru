    },
    "This file uses export format %lld, which this version of Piru can't read yet. Update Piru, then import it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este archivo usa el formato de exportación %lld, que esta versión de Piru aún no puede leer. Actualiza Piru y luego impórtalo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文件使用导出格式 %lld，当前版本的 Piru 还无法读取。请更新 Piru 后再导入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
