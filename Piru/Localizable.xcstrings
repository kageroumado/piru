    "Acetaminophen (paracetamol) after heavy alcohol use adds stress to the liver." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El paracetamol (acetaminofén) tras un consumo intenso de alcohol añade estrés al hígado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大量饮酒后服用对乙酰氨基酚（扑热息痛）会加重肝脏负担。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大量飲酒後服用乙醯胺酚（撲熱息痛）會加重肝臟負擔。"
          }
        }
      }
    },
    "Acid, nausea, and gut motility." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acidez, náuseas y motilidad intestinal."
          }
        },
        "zh-Hans" : {
