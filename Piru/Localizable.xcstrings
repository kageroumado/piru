    "Selective κ-Opioid Receptor Agonist" : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择性 κ-阿片受体激动剂"
          }
        },
        "zh-Hant" : {
