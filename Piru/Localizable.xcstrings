          "stringUnit" : {
            "state" : "translated",
            "value" : "為了推遲低落而多服，只會把低落往後推。"
          }
        }
      }
    },
    "Taking more within the same session adds to what is still active." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在同一场次中再服，会叠加到仍在起效的部分上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在同一場次中再服，會疊加到仍在起效的部分上。"
