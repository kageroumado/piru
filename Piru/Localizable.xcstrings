    "\"How is it going?\" at set points in a session, opening a timestamped note. Turned on per session; off unless you ask." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在过程中的几个时点提示“现在感觉如何？”，并打开一条带时间戳的笔记。按次开启；默认关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在過程中的幾個時點提示「現在感覺如何？」，並開啟一則帶時間戳的筆記。按次開啟；預設關閉。"
          }
        }
      }
