        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可能感到迷糊、嗜睡或輕微易怒。"
          }
        }
      }
    },
    "You may feel increased pain sensitivity, restlessness, or mild nausea." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可能感到痛觉增强、焦躁或轻度恶心。"
