    "“%@” isn’t in the library anymore. It may have been renamed or merged." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ya no está en la biblioteca. Puede que se haya renombrado o fusionado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”已不在资料库中，可能已被重命名或合并。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」已不在資料庫中，可能已被重新命名或合併。"
          }
        }
      }
    },
    "“2 due”, or the med’s name when one is due" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“2 pendientes”, o el nombre del medicamento cuando solo hay uno"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“2 项待服”，或仅一项时的药名"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「2 項待服」，或僅一項時的藥名"
          }
        }
      }
    },
    "\"How is it going?\" at set points in a session, opening a timestamped note. Turned on per session; off unless you ask." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«¿Cómo va?» en puntos fijos de una sesión, abriendo una nota con marca de tiempo. Se activa por sesión; desactivado a menos que lo pidas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在场次中的几个时点提示“现在感觉如何？”，并打开一条带时间戳的笔记。按场次开启；默认关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在場次中的幾個時點提示「現在感覺如何？」，並開啟一則帶時間戳的筆記。按場次開啟；預設關閉。"
          }
        }
      }
    },
