    "tolerance" : {
      "comment" : "Sources list — what a source supplies",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "耐受性"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
