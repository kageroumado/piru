          "stringUnit" : {
            "state" : "translated",
            "value" : "模型估計仍在活躍的內容"
          }
        }
      }
    },
    "What these curves cover" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些曲线涵盖什么"
