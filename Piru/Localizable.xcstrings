    "Point at any medication box to see what's inside it" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对准任意药盒，查看里面是什么"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對準任意藥盒，查看裡面是什麼"
          }
        }
      }
    },
    "Point at the box — name, strength, barcode" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对准药盒——名称、规格、条码"
