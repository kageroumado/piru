    "Psychedelics, dissociatives and cannabinoids are out of scope — pharmacokinetics is not what drives their effects." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "迷幻剂、解离剂与大麻素类不在适用范围内——药代动力学并非其效应的主导因素。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
