        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "舒爾金評級量表"
          }
        }
      }
    },
    "The skin unlocks as soon as the purchase is approved." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "购买获批后，皮肤会立即解锁。"
