    "Mostly fast receptor desensitization that recovers between uses rather than a lasting change." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Principalmente una desensibilización rápida de los receptores que se recupera entre usos, más que un cambio duradero."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主要是受体的快速脱敏，在两次使用之间就会恢复，而不是一种持久的变化。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
