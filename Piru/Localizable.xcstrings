        }
      }
    },
    "Adds up sedation and lowers blood pressure further — stronger drowsiness and dizziness." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "镇静叠加，血压进一步降低——困倦和头晕更强。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
