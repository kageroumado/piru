    "Time Sensitive notifications can break through Focus modes and the notification summary. Turn off any you'd rather have wait." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notificaciones sensibles al tiempo pueden atravesar los modos de concentración y el resumen de notificaciones. Desactiva las que prefieras que esperen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "时效性通知可以突破专注模式和通知摘要。不希望立即送达的可以在这里关闭。"
          }
        },
        "zh-Hant" : {
