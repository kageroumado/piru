    "Recreational doses — not a prescribed amount" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "娱乐用剂量——并非处方用量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
