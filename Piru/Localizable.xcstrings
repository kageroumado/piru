            "value" : "飲品表情"
          }
        }
      }
    },
    "Drink water and eat something nutritious." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bebe agua y come algo nutritivo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "喝水并吃些营养食物。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "喝水並吃些營養食物。"
          }
        }
      }
    },
    "Drink water and eat something." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bebe agua y come algo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "喝点水，吃点东西。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "喝點水，吃點東西。"
          }
        }
      }
    },
    "Drink water or an electrolyte drink, in sips." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bebe agua o una bebida con electrolitos, a sorbos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小口喝水或电解质饮料。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小口喝水或電解質飲料。"
          }
        }
      }
    },
    "Drink water, in sips. Eat something light." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bebe agua, a sorbos. Come algo ligero."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小口喝水。吃点清淡的东西。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小口喝水。吃點清淡的東西。"
          }
        }
      }
    },
    "Drink water. A dry mouth is an effect of cannabis itself and doesn't by itself mean dehydration." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bebe agua. La boca seca es un efecto del propio cannabis y por sí sola no significa deshidratación."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "喝点水。口干是大麻本身的作用，单凭它并不代表脱水。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "喝點水。口乾是大麻本身的作用，單憑它並不代表脫水。"
          }
        }
      }
    },
    "Drink water. Eat something simple when your stomach allows." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bebe agua. Come algo sencillo cuando el estómago te lo permita."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "喝水。胃能接受时吃些简单的食物。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "喝水。胃能接受時吃些簡單的食物。"
          }
        }
      }
    },
    "Drink water. Wrap up in something comfortable." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bebe agua. Abrígate con algo cómodo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "喝水。裹上舒适的衣物。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "喝水。裹上舒適的衣物。"
          }
        }
      }
    },
