    "LD50 is rodent toxicity (order of magnitude) — not a human safe dose." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LD50 为啮齿动物毒性（数量级参考），并非人体安全剂量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LD50 為齧齒動物毒性（數量級參考），並非人體安全劑量。"
          }
        }
      }
    },
    "Less" : {
      "localizations" : {
        "zh-Hans" : {
