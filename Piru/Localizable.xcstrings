    "Ritonavir strongly inhibits CYP3A4, sharply raising the levels of drugs cleared by it." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "利托那韦强烈抑制 CYP3A4，显著升高经该酶清除的药物的血药浓度。"
