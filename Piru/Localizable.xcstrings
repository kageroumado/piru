    "tolerance" : {
      "comment" : "Sources list — what a source supplies",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tolerancia"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
