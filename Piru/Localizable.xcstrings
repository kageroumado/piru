    },
    "You are not alone. People care about you and help is available." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您并不孤单。有人关心您,也有可用的帮助。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您並不孤單。有人關心您,也有可用的幫助。"
          }
        }
      }
    },
    "You may feel emotionally open, contemplative, or just tired." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可能感到情感开放、深思,或只是疲倦。"
