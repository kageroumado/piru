    },
    "Additive sedation and low blood pressure — increased drowsiness and dizziness." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "镇静与低血压叠加——困倦和头晕增加。"
