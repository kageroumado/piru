        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También medido en %1$@× la %3$@ de %2$@ en el %4$@ — una medición de laboratorio, no potencia clínica."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另在%4$@上测定值为 %2$@ %3$@的 %1$@ 倍——这是实验室测定值，并非临床效价。"
