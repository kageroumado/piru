    "Manual Backup" : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手动备份"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手動備份"
          }
        }
      }
    },
    "Manual exports turn your passphrase into a key with 600,000 rounds of PBKDF2. The passphrase is never saved or sent. Choose one you won't forget — there's no recovery." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手动导出会用 600,000 轮 PBKDF2 将你的口令转换为密钥。口令绝不会被保存或发送。请选择一个你不会忘记的口令——它无法找回。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手動匯出會以 600,000 輪 PBKDF2 將你的通行碼轉換為金鑰。通行碼絕不會被儲存或傳送。請選擇一個你不會忘記的通行碼——它無法找回。"
          }
        }
      }
    },
    "max" : {
