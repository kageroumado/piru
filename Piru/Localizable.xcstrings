    "Lower IC₅₀ / Kᵢ = more potent block." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menor IC₅₀ / Kᵢ = bloqueo más potente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IC₅₀／Kᵢ 越低 = 阻断作用越强。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IC₅₀／Kᵢ 越低 = 阻斷作用越強。"
          }
        }
      }
    },
    "Lower Ki means tighter binding. Affinity below ~100 nM is usually considered high." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un Ki menor significa una unión más fuerte. Una afinidad por debajo de ~100 nM suele considerarse alta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ki 越低表示结合越紧密。亲和力低于约 100 nM 通常被视为较高。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ki 越低表示結合越緊密。親和力低於約 100 nM 通常被視為較高。"
          }
        }
      }
    },
