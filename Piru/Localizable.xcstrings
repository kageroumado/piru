    "Steady state needs a regular schedule. Log a substance on a consistent cadence and its plateau appears here." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "稳态需要规律的用药安排。按固定节奏记录某种物质，其平台值就会显示在这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "穩態需要規律的用藥安排。按固定節奏記錄某種物質，其平台值就會顯示在這裡。"
          }
        }
      }
    },
    "Steep, supralinear — described in words (no reliable human kinetics)." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "陡峭、超线性——以文字说明（缺乏可靠的人体动力学数据）。"
