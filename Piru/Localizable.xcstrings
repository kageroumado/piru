    "Markdown — notes with T+ offsets" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markdown — notas con marcas T+"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markdown——带 T+ 偏移的笔记"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markdown——帶 T+ 偏移的筆記"
          }
        }
      }
    },
    "Marks the amount after this as a full supply, so the bar can show how full you are. Leave off if this isn't a full restock." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marca la cantidad resultante como suministro completo, para que la barra muestre cuánto te queda. Déjalo desactivado si no es una reposición completa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将此操作后的数量标记为满量，进度条便能显示你的充足程度。如果这不是一次补满，请关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將此操作後的數量標記為滿量，進度條便能顯示你的充足程度。如果這不是一次補滿，請關閉。"
          }
        }
      }
    },
    "max" : {
      "localizations" : {
