    "Skip intense or crowded environments until you feel grounded." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evita los entornos intensos o llenos de gente hasta que vuelvas a sentir los pies en la tierra."
          }
