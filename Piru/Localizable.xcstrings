    "One tap records how this dose is going — less than usual, about right, or more." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un toque registra cómo va esta dosis — menos de lo habitual, como siempre, o más."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一次轻点就能记下这次剂量的表现——比平时弱、和平时差不多，还是比平时强。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一次輕點就能記下這次劑量的表現——比平時弱、和平時差不多，還是比平時強。"
          }
        }
      }
    },
