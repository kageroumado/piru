    },
    "no tolerance" : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没耐受"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒耐受"
          }
        }
      }
    },
    "No tolerance between sessions. Every simulation starts from a naive baseline; acclimation within the session is modeled, carry-over from yesterday is not." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不含场次之间的耐受。每次模拟都从未接触药物的基线开始；场次内的适应有被建模，但昨天的残留影响没有。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不含場次之間的耐受。每次模擬都從未接觸藥物的基線開始；場次內的適應有被建模，但昨天的殘留影響沒有。"
          }
        }
      }
    },
    "No tracked substance matches the current search and filters." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有符合当前搜索和筛选条件的追踪物质。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有符合目前搜尋與篩選條件的追蹤物質。"
          }
        }
      }
    },
    "Nodnummer" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nodnummer"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nodnummer"
          }
        }
      }
    },
    "Non-opioid pain relief — NSAIDs, paracetamol." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非阿片类镇痛——NSAID、对乙酰氨基酚。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非鴉片類鎮痛——NSAID、乙醯胺酚。"
          }
        }
      }
    },
    "none" : {
      "extractionState" : "stale",
      "localizations" : {
