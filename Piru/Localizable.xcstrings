    "Rifampicin strongly induces CYP3A4, markedly lowering the levels of drugs cleared by it." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "利福平强烈诱导 CYP3A4，明显降低经该酶清除的药物的血药浓度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "利福平強烈誘導 CYP3A4，明顯降低經該酶清除的藥物的血藥濃度。"
          }
        }
      }
    },
