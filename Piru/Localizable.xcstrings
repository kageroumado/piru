        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些曲線涵蓋什麼"
          }
        }
      }
    },
    "What this does not model" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本模型不涵盖的内容"
