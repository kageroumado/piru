    "This is a rebound effect, not a return to baseline anxiety. It passes." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是反弹效应,而非回到基线焦虑。它会过去。"
          }
        },
        "zh-Hant" : {
