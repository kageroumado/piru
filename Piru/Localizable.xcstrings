        }
      }
    },
    "Transdermal fentanyl is dosed in micrograms per hour, a rate rather than a mass, so it has no figure in this mg-based table." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El fentanilo transdérmico se dosifica en microgramos por hora, una tasa y no una masa, así que no tiene cifra en esta tabla basada en mg."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透皮芬太尼按每小时微克计量，是速率而不是质量，因此在这张以 mg 为基准的表格中没有数值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "經皮吩坦尼按每小時微克計量，是速率而不是質量，因此在這張以 mg 為基準的表格中沒有數值。"
          }
        }
      }
    },
