    "Engraved gold, a plum night, a turning wheel" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oro grabado, una noche ciruela, una rueda que gira"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "镌刻的金色、梅紫夜空、缓缓旋转的星盘"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鐫刻的金色、梅紫夜空、緩緩旋轉的星盤"
          }
        }
      }
    },
    "Enhanced CNS depression — risk of respiratory depression and death." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depresión del SNC potenciada — riesgo de depresión respiratoria y muerte."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加重的中枢抑制——有呼吸抑制和死亡的风险。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加重的中樞抑制——有呼吸抑制和死亡的風險。"
          }
        }
      }
    },
    "Enhanced respiratory depression — gabapentinoids increase opioid overdose risk." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depresión respiratoria potenciada — los gabapentinoides aumentan el riesgo de sobredosis de opioides."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加重的呼吸抑制——加巴喷丁类增加阿片类过量风险。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加重的呼吸抑制——加巴噴丁類增加鴉片類過量風險。"
          }
        }
      }
    },
    "Enter a vial amount, diluent volume, and target dose." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce la cantidad del vial, el volumen de diluyente y la dosis objetivo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请输入瓶内总量、溶剂体积和目标剂量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請輸入瓶內總量、溶劑體積與目標劑量。"
          }
        }
      }
    },
    "Enter it in your lab's unit. Stored in %@." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introdúcelo en la unidad de tu laboratorio. Se guarda en %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按化验单的单位输入。以 %@ 保存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按化驗單的單位輸入。以 %@ 儲存。"
          }
        }
      }
    },
    "Enter Passphrase" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introducir frase de contraseña"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "输入口令"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輸入通行碼"
          }
        }
      }
    },
    "Enter the vial's concentration — a volume alone isn't a dose." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce la concentración del vial — un volumen por sí solo no es una dosis."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请输入药瓶的浓度——仅有体积并不构成剂量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請輸入藥瓶的濃度——僅有體積並不構成劑量。"
          }
        }
      }
    },
    "Entered manually. Your weight sizes every dose estimate — the same dose hits harder the less you weigh." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introducido manualmente. Tu peso dimensiona cada estimación de dosis — la misma dosis pega más fuerte cuanto menos pesas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已手动输入。体重决定每项剂量估算——越轻，同样的剂量作用越强。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已手動輸入。體重決定每項劑量估算——越輕，同樣的劑量作用越強。"
          }
        }
      }
    },
    "entries" : {
      "localizations" : {
