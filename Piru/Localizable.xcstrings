    },
    "This file isn't a valid Piru backup." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este archivo no es una copia de seguridad válida de Piru."
          }
        },
        "zh-Hans" : {
