        }
      }
    },
    "Risk of fatal serotonin syndrome — do not combine." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有致命血清素综合征的风险 — 切勿合用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有致命血清素綜合徵的風險 — 切勿合用。"
          }
        }
      }
    },
    "Risk of respiratory depression, aspiration, and loss of consciousness." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有呼吸抑制、误吸和意识丧失的风险。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有呼吸抑制、誤吸和意識喪失的風險。"
          }
        }
      }
    },
    "Risk of serotonin syndrome and hypertensive crisis." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有血清素综合征和高血压危象的风险。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有血清素綜合徵和高血壓危象的風險。"
          }
        }
      }
    },
    "Risk of serotonin syndrome, especially with meperidine/pethidine, tramadol, and tapentadol." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有血清素综合征的风险,尤其是与哌替啶、曲马多和他喷他多。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有血清素綜合徵的風險,尤其是與哌替啶、曲馬多和他噴他多。"
          }
        }
      }
    },
    "Room temperature" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "室温"
          }
        },
        "zh-Hant" : {
