      }
    },
    "Copies set aside automatically (after an upgrade hiccup) or before a restore appear here, ready to restore." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las copias apartadas automáticamente (tras un tropiezo en una actualización) o antes de una restauración aparecen aquí, listas para restaurar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
