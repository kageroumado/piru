    "Already keep a journal? Import a Piru backup or a PsyLog-format export — or start with a clean slate." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Ya llevas un diario? Importa una copia de seguridad de Piru o una exportación en formato PsyLog — o empieza de cero."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已经在记录了？导入 Piru 备份或 PsyLog 格式的导出文件——或者从头开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
