    "Small sips once it settles. Vomiting while very drowsy is an emergency — stay on your side and get help." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorbos pequeños cuando se asiente. Vomitar con mucha somnolencia es una emergencia — quédate de lado y busca ayuda."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "等它平息后小口喝水。在非常昏沉时呕吐属于急症——保持侧卧并寻求帮助。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "等它平息後小口喝水。在非常昏沉時嘔吐屬於急症——保持側臥並尋求幫助。"
          }
        }
      }
    },
