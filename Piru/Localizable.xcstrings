          }
        }
      }
    },
    "Published equivalences are approximate and vary between sources. A prescriber must assess any medication change." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las equivalencias publicadas son aproximadas y varían entre fuentes. Cualquier cambio de medicación debe evaluarlo quien prescribe."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已发表的等效量均为近似值，不同来源之间可能存在差异。任何用药调整都须由处方医生评估。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已發表的等效量均為近似值，不同來源之間可能存在差異。任何用藥調整都須由處方醫師評估。"
          }
        }
      }
    },
    "Published oral MME reference factors" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Factores de referencia MME orales publicados"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已发表的口服 MME 参考系数"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已發表的口服 MME 參考係數"
          }
        }
      }
    },
    "Published oral morphine milligram equivalent (MME) factors compare amounts across opioids. They must not be used to choose a replacement dose when switching medications." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los factores publicados de equivalente en miligramos de morfina (MME) oral comparan cantidades entre opioides. No deben usarse para elegir una dosis de reemplazo al cambiar de medicación."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已发表的口服吗啡毫克当量（MME）系数用于比较不同阿片类药物的用量。换药时不得用这些系数确定替代剂量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已發表的口服嗎啡毫克當量（MME）係數用於比較不同鴉片類藥物的用量。換藥時不得用這些係數確定替代劑量。"
          }
        }
      }
    },
