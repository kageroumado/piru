    "release EC₅₀" : {
      "comment" : "Ternary axis basis",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EC₅₀ de liberación"
          }
        },
        "zh-Hans" : {
