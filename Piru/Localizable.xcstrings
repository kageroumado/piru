    },
    "Each line is one dose; its height is the level in your blood and the area under it is your total exposure. Time is in days." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每条曲线代表一个剂量；高度是血液中的水平，曲线下面积是你的总暴露量。时间以天为单位。"
          }
        },
        "zh-Hant" : {
