    },
    "You don't have to do this alone" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你不必独自面对"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你不必獨自面對"
          }
        }
      }
    },
    "You don't have to do this alone. Help is one tap away." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你不必独自面对。帮助只需轻点一下。"
