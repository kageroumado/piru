          }
        }
      }
    },
    "Serotonin syndrome risk — a serotonin-raising drug stacked with an SSRI." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "血清素综合征风险——升高血清素的药物与 SSRI 叠加。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
