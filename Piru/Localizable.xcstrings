          "stringUnit" : {
            "state" : "translated",
            "value" : "你的身體會學著做好準備"
          }
        }
      }
    },
    "Your body turns %@ into %@, which is active too." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your body turns %1$@ into %2$@, which is active too."
