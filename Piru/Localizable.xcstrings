    },
    "Modulates airway function through mechanisms including bronchodilation via β2-adrenergic agonism or anticholinergic blockade, anti-inflammatory effects from corticosteroids, mast cell stabilization, or leukotriene receptor antagonism." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modula la función de las vías respiratorias mediante mecanismos como la broncodilatación por agonismo β2-adrenérgico o bloqueo anticolinérgico, los efectos antiinflamatorios de los corticosteroides, la estabilización de mastocitos o el antagonismo de los receptores de leucotrienos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过 β2-肾上腺素激动或抗胆碱阻断引起的支气管扩张、皮质激素的抗炎效应、肥大细胞稳定或白三烯受体拮抗等机制调节气道功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過 β2-腎上腺素促效或抗膽鹼阻斷引起的支氣管擴張、皮質激素的抗炎效應、肥大細胞穩定或白三烯受體拮抗等機制調節氣道功能。"
          }
        }
      }
    },
    "Modulates cardiovascular function through mechanisms including adrenergic receptor blockade, calcium channel inhibition, renin-angiotensin system modulation, or direct vasodilation. The specific mechanism depends on the drug class." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modula la función cardiovascular mediante mecanismos como el bloqueo de receptores adrenérgicos, la inhibición de canales de calcio, la modulación del sistema renina-angiotensina o la vasodilatación directa. El mecanismo concreto depende de la clase del fármaco."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过肾上腺素受体阻断、钙通道抑制、肾素-血管紧张素系统调节或直接血管扩张等机制调节心血管功能。具体机制取决于药物类别。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過腎上腺素受體阻斷、鈣通道抑制、腎素-血管收縮素系統調節或直接血管擴張等機制調節心血管功能。具體機制取決於藥物類別。"
          }
        }
      }
    },
    "Modulates digestive function through mechanisms such as acid secretion inhibition, motility modulation, mucosal protection, or neurotransmitter receptor interactions in the enteric nervous system." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modula la función digestiva mediante mecanismos como la inhibición de la secreción ácida, la modulación de la motilidad, la protección de la mucosa o interacciones con receptores de neurotransmisores en el sistema nervioso entérico."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过酸分泌抑制、动力调节、黏膜保护或肠神经系统中的神经递质受体相互作用等机制调节消化功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過酸分泌抑制、動力調節、黏膜保護或腸神經系統中的神經傳導物質受體相互作用等機制調節消化功能。"
          }
        }
      }
    },
    "Modulates hormonal signaling through receptor agonism or antagonism, enzyme inhibition affecting hormone synthesis or metabolism, or direct hormone replacement. Interacts with the hypothalamic-pituitary-endocrine axes." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modula la señalización hormonal mediante agonismo o antagonismo de receptores, inhibición enzimática que afecta a la síntesis o el metabolismo hormonal, o reemplazo hormonal directo. Interactúa con los ejes hipotálamo-hipófisis-endocrinos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过受体激动或拮抗、影响激素合成或代谢的酶抑制，或直接激素替代来调节激素信号。与下丘脑-垂体-内分泌轴相互作用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過受體促效或拮抗、影響激素合成或代謝的酶抑制，或直接激素替代來調節激素訊號。與下丘腦-腦垂體-內分泌軸相互作用。"
          }
        }
      }
    },
    "Modulates immune system function through mechanisms such as inhibition of inflammatory cytokine production, suppression of T-cell or B-cell activation, complement system modulation, or targeted inhibition of specific immune pathways." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modula la función del sistema inmunitario mediante mecanismos como la inhibición de la producción de citocinas inflamatorias, la supresión de la activación de linfocitos T o B, la modulación del sistema del complemento o la inhibición dirigida de vías inmunitarias específicas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过抑制炎症细胞因子产生、抑制 T 细胞或 B 细胞激活、补体系统调节或对特定免疫通路的靶向抑制等机制调节免疫系统功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過抑制發炎細胞因子產生、抑制 T 細胞或 B 細胞活化、補體系統調節或對特定免疫通路的靶向抑制等機制調節免疫系統功能。"
          }
        }
      }
    },
    "Modulates monoamine neurotransmitter systems (serotonin, norepinephrine, and/or dopamine) through various mechanisms including reuptake inhibition, enzyme inhibition, or receptor modulation. The specific mechanism depends on the drug class. Therapeutic effects typically develop over 2–6 weeks." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modula los sistemas de neurotransmisores monoaminérgicos (serotonina, noradrenalina y/o dopamina) mediante diversos mecanismos, como la inhibición de la recaptación, la inhibición enzimática o la modulación de receptores. El mecanismo concreto depende de la clase del fármaco. Los efectos terapéuticos suelen desarrollarse en 2–6 semanas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过再摄取抑制、酶抑制或受体调节等多种机制调节单胺神经递质系统（血清素、去甲肾上腺素和/或多巴胺）。具体机制取决于药物类别。治疗效应通常在 2–6 周内显现。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過再攝取抑制、酶抑制或受體調節等多種機制調節單胺神經傳導物質系統（血清素、正腎上腺素和/或多巴胺）。具體機制取決於藥物類別。治療效應通常在 2–6 週內顯現。"
          }
        }
      }
    },
