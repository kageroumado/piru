            "value" : "Algunas combinaciones aumentan el riesgo serotoninérgico o de convulsiones — vigila los síntomas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "某些组合会增加血清素或癫痫的风险——注意监测症状。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
