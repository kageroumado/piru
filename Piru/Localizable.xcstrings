    "Combine Repeated Entries" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combinar registros repetidos"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
