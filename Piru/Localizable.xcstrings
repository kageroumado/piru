    "Strong" : {
      "comment" : "Dose band",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "强效"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "強效"
          }
        }
      }
    },
    "Strong and fast: a second trip soon after is much weaker. Resets within a few days." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "强而快：短期内再次体验会弱很多。数天内重置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "強而快：短期內再次體驗會弱很多。數天內重置。"
          }
        }
      }
    },
    "Strong encryption" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "强加密"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "強加密"
          }
        }
      }
    },
    "Stronger doesn't mean more dangerous — it's just how tightly the drug grips that one target in the lab." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更强并不代表更危险——它只是表示在实验室中药物与该靶点结合的紧密程度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更強並不代表更危險——它只是表示在實驗室中藥物與該靶點結合的緊密程度。"
          }
        }
      }
    },
    "Strongly dopaminergic (SERT-sparing)" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "强多巴胺能（对 SERT 作用很弱）"
