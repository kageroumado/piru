    "Ask Again sends another reminder if a dose isn't logged — “Default” uses the intervals in Notification Settings." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Volver a preguntar” envía otro recordatorio si una dosis no se registra — “Predeterminado” usa los intervalos de los ajustes de notificaciones."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果一剂还未记录，“再次提醒”会再发一次提醒。“默认”使用通知设置中的间隔。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果一劑還未記錄，「再次提醒」會再發一次提醒。「預設」使用通知設定中的間隔。"
          }
        }
      }
    },
    "Asking…" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicitando…"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在请求…"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在請求…"
          }
        }
      }
    },
    "Asks again a little later if a med still isn't logged — like snooze for an alarm. Adjustable per med." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a preguntar un poco más tarde si un medicamento sigue sin registrarse — como posponer una alarma. Ajustable por medicamento."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果某项用药仍未被记录，稍后会再问一次——就像闹钟的稍后提醒。可为每项用药单独调整。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果某項用藥仍未被記錄，稍後會再問一次——就像鬧鐘的稍後提醒。可為每項用藥單獨調整。"
          }
        }
      }
    },
