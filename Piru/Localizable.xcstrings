    "Amplifies GABA — it doesn't open the channel on its own." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amplifica el GABA — no abre el canal por sí mismo."
          }
        },
