    "Testosterone (suppression)" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testosterona (supresión)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睾酮（抑制）"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睪固酮（抑制）"
          }
        }
      }
    },
    "Testosterone aromatizes to estradiol, so E2 often rises on T. Piru plots your measured points — the conversion is person-specific, not modeled." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La testosterona se aromatiza a estradiol, así que el E2 suele subir con la T. Piru traza tus puntos medidos — la conversión depende de cada persona y no está modelada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睾酮会芳香化为雌二醇，所以用 T 期间 E2 常会上升。Piru 绘制你的实测点——这种转化因人而异，未被建模。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睪固酮會芳香化為雌二醇，所以用 T 期間 E2 常會上升。Piru 繪製你的實測點——這種轉化因人而異，未被建模。"
          }
        }
      }
    },
    "Testosterone ester curves are fit from label and primary-literature half-lives — there is no community PK simulator for them, so the band stays wide until your lab results calibrate the model." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las curvas de los ésteres de testosterona se ajustan a partir de las vidas medias del prospecto y de la literatura primaria — no existe un simulador PK comunitario para ellos, así que la banda se mantiene ancha hasta que tus resultados de laboratorio calibren el modelo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睾酮酯曲线根据说明书和原始文献中的半衰期拟合而成。由于没有适用的社区药代动力学模拟器，在用你的化验结果校准模型前，误差带会较宽。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睪固酮酯曲線根據說明書和原始文獻中的半衰期擬合而成。由於沒有適用的社群藥物動力學模擬器，在用你的檢驗結果校準模型前，誤差帶會較寬。"
          }
        }
      }
    },
    "Testosterone raises red-cell production, so hematocrit is monitored on T (largest rise in the first year). These are your measured points, plotted, not a prediction." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La testosterona aumenta la producción de glóbulos rojos, por eso se vigila el hematocrito durante la T (la mayor subida ocurre el primer año). Estos son tus puntos medidos, trazados, no una predicción."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睾酮会提高红细胞生成，所以用 T 期间要监测血细胞比容（第一年升幅最大）。这些是你实测点的绘图，不是预测。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睪固酮會提高紅血球生成，所以用 T 期間要監測血球容積比（第一年升幅最大）。這些是你實測點的繪圖，不是預測。"
          }
        }
      }
    },
    "Text" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texto"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文本"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字"
          }
        }
      }
    },
    "Text detected from the label. Check the name, strength and formulation before saving — a scan can't verify what is inside the box. Not medical advice." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texto detectado en la etiqueta. Comprueba el nombre, la concentración y la formulación antes de guardar — un escaneo no puede verificar lo que hay dentro de la caja. No es consejo médico."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从标签上识别出的文字。保存前请核对名称、规格和剂型——扫描无法验证盒子里面装的是什么。非医疗建议。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從標籤上識別出的文字。儲存前請核對名稱、規格和劑型——掃描無法驗證盒子裡面裝的是什麼。非醫療建議。"
          }
        }
      }
    },
    "Text from PsychonautWiki and FreeOD Wiki, as edited and merged in Piru." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texto de PsychonautWiki y FreeOD Wiki, editado y fusionado en Piru."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "来自 PsychonautWiki 和 FreeOD Wiki 的文本，经 Piru 编辑并合并。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "來自 PsychonautWiki 和 FreeOD Wiki 的文字，經 Piru 編輯並合併。"
          }
        }
      }
    },
    "Text HOME to 741741" : {
      "localizations" : {
        "es" : {
